#!/usr/bin/env bash
# preview CONFIG_DIR SAMPLE OUT.png: render one island window in a sample state to a PNG.
# The window opens 300px down on the current DISPLAY, over a solid backdrop, from a private copy
# of CONFIG_DIR whose listeners and polls are frozen to plain variables and whose animations are
# off, so only the sample decides the picture.
# SAMPLE: "window=island|island-expanded", optional "tab=<id>", then "var=<json>" lines;
# @ASSETS@ in a value stands for the absolute path of the sample's assets/ folder.
set -euo pipefail
# shellcheck source=lib/preview.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/preview.sh"

SETTLE=${PREVIEW_SETTLE:-1.5}

usage() {
  if [[ -n ${1:-} ]]; then printf 'preview: %s\n' "$1" >&2; fi
  printf 'pemakaian: preview CONFIG_DIR SAMPLE OUT.png\n' >&2
  exit 2
}

main() {
  (( $# == 3 )) || usage
  local config=$1 sample=$2 out=$3 crop
  [[ -d $config ]] || usage "CONFIG_DIR tidak ada: $config"
  [[ -f $sample ]] || usage "SAMPLE tidak ada: $sample"
  preview_sample "$sample" || usage
  case $SAMPLE_WINDOW in
    island) crop=520x46 ;;
    island-expanded)
      crop=520x230
      SAMPLE_UPDATES+=(island_reveal=true)
      if [[ -n $SAMPLE_TAB ]]; then SAMPLE_UPDATES+=("island_tab=$SAMPLE_TAB"); fi ;;
    *) usage "window harus island atau island-expanded: '$SAMPLE_WINDOW'" ;;
  esac

  trap preview_cleanup EXIT
  preview_prepare "$config" still
  preview_start
  ew open "$SAMPLE_WINDOW" >/dev/null
  # After open: a stack built with a selection already set shows no page (eww 0.5).
  if (( ${#SAMPLE_UPDATES[@]} )); then ew update "${SAMPLE_UPDATES[@]}"; fi
  sleep "$SETTLE"
  import -window root -crop "$crop+700+300" +repage "$out"
}

main "$@"
