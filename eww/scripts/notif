#!/usr/bin/env bash
# notif: deflisten printing the notification center (expanded card tab "notif"), one JSON object per line.
# notif click ID | clear | scroll up|down
# The list is dunst's history (lib/notify/history.sh).
# Input is the FIFO $ISLAND_STATE/notif.fifo: "@refresh" (notify-hook, click, clear),
# "@expanded 0|1" (scripts/island), "@tab NAME" (scripts/tab) and "@scroll -1|1".
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/listener.sh
source "$DIR/lib/listener.sh"
# shellcheck source=lib/paged.sh
source "$DIR/lib/paged.sh"
# shellcheck source=lib/notify/clean.sh
source "$DIR/lib/notify/clean.sh"
# shellcheck source=lib/notify/history.sh
source "$DIR/lib/notify/history.sh"
# shellcheck source=lib/notify/activate.sh
source "$DIR/lib/notify/activate.sh"
# shellcheck source=lib/notify/wake.sh
source "$DIR/lib/notify/wake.sh"
ROWS=4

# Entries -> the eww value. $ARGS.positional lists the icon paths that exist.
RENDER_JQ="$CLEAN_JQ"'def ago: ($now - .ts) / 1000000 | floor
    | if . < 60 then "baru saja" elif . < 3600 then "\(. / 60 | floor) mnt"
      elif . < 86400 then "\(. / 3600 | floor) jam" else "\(. / 86400 | floor) hari" end;
  length as $total | ([.[] | select(.ts > $seen)] | length) as $unread | ('"$PAGED_JQ"') as $page
  | {total: $total, unread: $unread, label: ("Notifikasi" + (if $unread > 0 then " \($unread)" else "" end)),
     rows: [$page.rows[]
       | {id, app, summary, body, time: ago, critical, icon: $bell,
          image: (if .icon != "" and (.icon | IN($ARGS.positional[])) then .icon | file_uri else "" end)}],
     more: $page.more, offset: $page.offset}'

# uptime_us: now on dunst's timestamp clock (CLOCK_BOOTTIME, as /proc/uptime), in microseconds.
uptime_us() {
  local up=''
  read -r up _ 2>/dev/null < "${ISLAND_UPTIME_FILE:-/proc/uptime}"
  if [[ $up =~ ^[0-9]+(\.[0-9]+)?$ ]]; then seconds_us "$up"; else printf 0; fi
}

# load: reread dunst history and keep the offset within it.
load() {
  history_load
  (( offset <= total - ROWS )) || offset=$(( total > ROWS ? total - ROWS : 0 ))
}

# update: rebuild the shown value. While the island shows this tab, everything up to now counts as read.
update() {
  local now seen='' json
  now=$(uptime_us)
  if (( expanded )) && [[ $(island_eww get island_tab 2>/dev/null) == notif ]]; then
    seen=$now
    printf '%s\n' "$now" > "$ISLAND_STATE/notif_seen"
  else
    read -r seen 2>/dev/null < "$ISLAND_STATE/notif_seen"
    [[ $seen =~ ^[0-9]+$ ]] || seen=0
  fi
  if (( expanded )); then tick_at=$((${EPOCHREALTIME/./} + tick_every_us)); fi
  json=$(jq -c --argjson now "$now" --argjson seen "$seen" --argjson offset "$offset" --argjson rows "$ROWS" \
    --arg bell "$ICON_BELL" "$RENDER_JQ" --args "${icons[@]}" <<< "$entries" 2>/dev/null) || return 0
  view=$json
}

# scroll STEP: move the shown rows by STEP within the list.
scroll() {
  local next=$((offset + $1)) top=$(( total > ROWS ? total - ROWS : 0 ))
  (( next < 0 )) && next=0
  (( next > top )) && next=$top
  if (( next != offset )); then offset=$next; update; fi
}

# wake VAR: when to reload next: the settle after "@refresh", else while expanded the relative-time tick.
wake() {
  local due=$refresh_at
  (( due || ! expanded )) || due=$tick_at
  printf -v "$1" '%d' "$due"
}

notif_render() { [[ -n $view ]] && printf '%s' "$view"; }

notif_handle() {
  local at
  wake at
  if (( at && at <= ${EPOCHREALTIME/./} )); then refresh_at=0; load; update; fi
  case $1 in
    # dunst stores a notification right after starting its hook: wait, and take a burst at once.
    '@refresh') (( refresh_at )) || refresh_at=$((${EPOCHREALTIME/./} + refresh_delay_us)) ;;
    # scripts/island repeats this while the pointer stays; only opening rereads the history.
    '@expanded 1') if (( ! expanded )); then expanded=1; load; update; fi ;;
    '@expanded 0') if (( expanded )); then expanded=0; offset=0; update; fi ;;
    '@tab '*) if (( expanded )); then update; fi ;;
    '@scroll -1') scroll -1 ;;
    '@scroll 1') scroll 1 ;;
  esac
  wake at
  wake_at "$at"
}

# click ID: activate the entry's app like the pill click, then drop it and its copies from history.
click() {
  local app entry
  history_take "$1" app entry || return 0
  activate "$app" "$entry" > /dev/null 2>&1 &
  notif_signal '@refresh'
}

usage() { printf 'usage: notif [click ID | clear | scroll up|down]\n' >&2; return 2; }

main() {
  case ${1:-} in
    click) [[ ${2:-} =~ ^[0-9]+$ ]] || { usage; return; }; click "$((10#$2))"; return 0 ;;
    clear) history_clear; notif_signal '@refresh'; return 0 ;;
    scroll)
      case ${2:-} in
        up) notif_signal '@scroll -1' ;;
        down) notif_signal '@scroll 1' ;;
        *) usage; return ;;
      esac
      return 0 ;;
    '') ;;
    *) usage; return ;;
  esac
  require jq || { printf 'notif: jq tidak tersedia\n' >&2; return 127; }
  # Not settle_us/tick_us: listen's own locals would shadow them in the handlers.
  local entries='[]' total=0 offset=0 expanded=0 view='' refresh_at=1 tick_at=0 refresh_delay_us tick_every_us
  local -a icons=()
  refresh_delay_us=$(seconds_us "${ISLAND_NOTIF_SETTLE_SECONDS:-0.15}")
  tick_every_us=$(seconds_us "${ISLAND_NOTIF_TICK_SECONDS:-60}")
  # The first load is a refresh due at once, so it runs after the FIFO exists and misses no "@refresh".
  # shellcheck disable=SC2034 # read by listen
  listen_tick=0.000001
  LISTEN_SETTLE=0 listen notif notif_render notif_handle
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
