#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
declare -g DIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$DIR/lib.sh"

mic_snapshot() {
  local outputs sources report
  outputs=$(pactl -f json list source-outputs) || outputs=''
  sources=$(pactl -f json list short sources) || sources=''
  if ! report=$(jq -cn --argjson outputs "$outputs" --argjson sources "$sources" '
    if ($outputs | type) != "array" or ($sources | type) != "array" then
      error("Expected pactl arrays")
    else
    [$outputs[] | . as $output |
      ($sources | map(select((.index | tostring) == ($output.source | tostring))) | .[0].name // "") as $source |
      select(($source | endswith(".monitor") | not) and
        (.properties["application.name"] != "eww-island-viz") and
        (.properties["stream.capture.sink"] != "true")) |
      [.properties["application.name"], .properties["application.process.binary"], "Aplikasi"] |
      map(select(. != null and . != "")) | .[0]] | unique |
    {source:"mic",active:(length > 0),apps:join(", ")}
    end' 2>/dev/null); then
    report='{"source":"mic","active":false,"apps":""}'
  fi
  printf '%s\n' "$report"
}

camera_snapshot() {
  local pid name device pattern names=''
  local active=false
  local -a matches=()
  for device in "${devices[@]}"; do
    pattern=${device//\\/\\\\}
    pattern=${pattern//\*/\\*}
    pattern=${pattern//\?/\\?}
    pattern=${pattern//\[/\\[}
    (( ${#matches[@]} )) && matches+=(-o)
    matches+=(-lname "$pattern")
  done
  while IFS= read -r -d '' pid; do
    pid=${pid%/fd}
    [[ ${pid##*/} != "$$" ]] || continue
    active=true
    name=''
    if [[ -r $pid/comm ]]; then IFS= read -r name < "$pid/comm" || :; fi
    names+="$name"$'\n'
  done < <(find "${ISLAND_PROC:-/proc}"/[0-9]*/fd -maxdepth 1 -type l -readable \
    \( "${matches[@]}" \) -printf '%h\0' 2>/dev/null)
  jq -cn --argjson active "$active" --arg names "$names" '
    {source:"camera",active:$active,apps:($names | split("\n") |
      map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)) | unique | join(", "))}'
}

dnd_snapshot() {
  local paused
  paused=$(dunstctl is-paused 2>/dev/null) || paused=false
  if [[ $paused == true ]]; then
    printf '{"source":"dnd","active":true,"apps":""}\n'
  else
    printf '{"source":"dnd","active":false,"apps":""}\n'
  fi
}

HEADPHONE_NONE='{"kind":"none","icon":"","name":"","battery":null,"low":false,"label":""}'
BLUEZ_RE="PropertiesChanged \\('org\\.bluez\\.(Battery1', \\{.*'Percentage'|Device1', \\{.*'Connected')"

# headphone_snapshot: the default sink as a bluetooth headset, wired headphones or nothing.
headphone_snapshot() {
  local sink json line='' kind=none name='' mac='' info battery='' icon=''
  if sink=$(pactl get-default-sink 2>/dev/null) && json=$(pactl -f json list sinks 2>/dev/null); then
    line=$(jq -r --arg sink "$sink" 'first(.[] | select(.name == $sink)) | . as $s
      | (first(($s.ports // [])[] | select(.name == $s.active_port)) // {}) as $p
      | if ($sink | startswith("bluez_")) then
          ["bt", $s.description // "", $s.properties["api.bluez5.address"]
            // (try ($sink | capture("(?<m>[0-9A-Fa-f]{2}(_[0-9A-Fa-f]{2}){5})").m | gsub("_"; ":")) catch "")]
        elif ([$p.name, $p.description, $p.type, $s.description] | map(. // "") | join(" ")
          | ascii_downcase | test("headphone|headset")) then
          ["wired", $p.description // $s.description // "", ""]
        else ["none", "", ""] end
      | join("\u001f")' <<< "$json" 2>/dev/null) || line=''
  fi
  [[ -n $line ]] && IFS=$'\x1f' read -r kind name mac <<< "$line"
  case $kind in
    bt)
      icon=$ICON_HEADPHONES_BT
      # bluetoothctl waits forever for bluetoothd when the daemon is down.
      if [[ -n $mac ]] && info=$(timeout 3 bluetoothctl info "$mac" 2>/dev/null); then
        while read -r line; do
          case $line in
            'Alias: '?*) name=${line#Alias: } ;;
            'Battery Percentage: '*) if [[ $line =~ \(([0-9]+)\) ]]; then battery=${BASH_REMATCH[1]}; fi ;;
          esac
        done <<< "$info"
      fi ;;
    wired) icon=$ICON_HEADPHONES ;;
    *) printf '{"source":"headphone","headphone":%s}\n' "$HEADPHONE_NONE"; return ;;
  esac
  jq -cn --arg kind "$kind" --arg icon "$icon" --arg name "$name" --arg battery "$battery" '
    ($battery | if . == "" then null else tonumber end) as $b |
    {source:"headphone",headphone:{kind:$kind,icon:$icon,name:$name,battery:$b,
      low:($b != null and $b <= 20),label:($name + (if $b == null then "" else " · \($b)%" end))}}'
}

# audio_snapshot: both pactl-backed states, microphone and headphone.
audio_snapshot() {
  mic_snapshot
  headphone_snapshot
}

bluez_snapshot() { headphone_snapshot; }

status_event() {
  local source=$1 line=$2
  case $source in
    audio)
      case $line in
        *' on server'*) mic_snapshot; headphone_snapshot ;;
        *' on source-output #'*|*' on source #'*) mic_snapshot ;;
        *' on sink #'*) headphone_snapshot ;;
      esac ;;
    camera) camera_snapshot ;;
    dnd)
      case $line in
        *member=PropertiesChanged*|*member=NameOwnerChanged*) dnd_snapshot ;;
      esac ;;
    bluez) if [[ $line =~ $BLUEZ_RE ]]; then headphone_snapshot; fi ;;
  esac
}

monitor_stream() {
  local source=$1 line fd
  shift
  coproc STATUS_MONITOR { exec "$@"; }
  monitor_pid=$STATUS_MONITOR_PID
  fd=${STATUS_MONITOR[0]}
  "${source}_snapshot"
  while IFS= read -r -u "$fd" line; do status_event "$source" "$line"; done
  wait "$monitor_pid" 2>/dev/null || :
  monitor_pid=''
}

worker_cleanup() {
  if [[ -n $monitor_pid ]]; then
    kill "$monitor_pid" 2>/dev/null || :
    wait "$monitor_pid" 2>/dev/null || :
  fi
}

source_worker() {
  local source=$1 tool device monitor_pid=''
  local -a tools=() devices=()
  trap 'exit 0' TERM INT HUP
  trap worker_cleanup EXIT
  case $source in
    audio) tools=(pactl) ;;
    camera)
      for device in "${ISLAND_DEV:-/dev}"/video*; do
        [[ -e $device ]] && devices+=("$device")
      done
      if (( ${#devices[@]} == 0 )); then
        printf '{"source":"camera","active":false,"apps":""}\n'
        return 0
      fi
      tools=(inotifywait find) ;;
    dnd) tools=(dunstctl dbus-monitor) ;;
    bluez) tools=(gdbus) ;;
  esac
  for tool in "${tools[@]}"; do
    if ! require "$tool"; then
      printf 'status: sumber %s dilewati, %s tidak tersedia\n' "$source" "$tool" >&2
      case $source in
        # The audio worker alone reports the headphone without bluez.
        bluez) ;;
        audio)
          printf '{"source":"mic","active":false,"apps":""}\n'
          printf '{"source":"headphone","headphone":%s}\n' "$HEADPHONE_NONE" ;;
        *) printf '{"source":"%s","active":false,"apps":""}\n' "$source" ;;
      esac
      return 0
    fi
  done
  case $source in
    audio) run_forever monitor_stream audio pactl subscribe ;;
    bluez) run_forever monitor_stream bluez gdbus monitor --system --dest org.bluez ;;
    camera) run_forever monitor_stream camera inotifywait -m -q -e open,close "${devices[@]}" ;;
    dnd)
      run_forever monitor_stream dnd dbus-monitor --session \
        "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path='/org/freedesktop/Notifications'" \
        "type='signal',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='org.freedesktop.Notifications'" ;;
  esac
}

listener_cleanup() {
  local pid
  for pid in "${worker_pids[@]}"; do kill "$pid" 2>/dev/null || :; done
  for pid in "${worker_pids[@]}"; do wait "$pid" 2>/dev/null || :; done
  rm -rf -- "$workdir"
}

main() {
  require jq || { printf 'status: jq tidak tersedia\n' >&2; return 127; }
  local state="${XDG_RUNTIME_DIR:-/tmp}/eww-island" workdir source input_fd
  local line active apps headphone=$HEADPHONE_NONE json last='' initialized=0
  local mic=false mic_apps='' camera=false camera_apps='' dnd=false
  local -A seen=()
  local -a worker_pids=()
  mkdir -p "$state"
  workdir=$(mktemp -d "$state/status.XXXXXX") || return
  trap 'exit 0' TERM INT HUP
  trap listener_cleanup EXIT
  mkfifo "$workdir/events"
  exec {input_fd}<> "$workdir/events"
  for source in audio camera dnd bluez; do
    source_worker "$source" > "$workdir/events" &
    worker_pids+=("$!")
  done
  while IFS= read -r -u "$input_fd" line; do
    IFS=$'\x1f' read -r source active apps json < <(jq -r \
      '[.source, (.active | tostring), (.apps // ""), (.headphone | tojson)] | join("\u001f")' <<< "$line")
    case $source in
      mic) mic=$active mic_apps=$apps ;;
      camera) camera=$active camera_apps=$apps ;;
      dnd) dnd=$active ;;
      headphone) headphone=$json ;;
      *) continue ;;
    esac
    if [[ ! ${seen[$source]:-} ]]; then
      seen[$source]=1
      initialized=$((initialized + 1))
    fi
    (( initialized == 4 )) || continue
    json=$(jq -cn --argjson mic "$mic" --arg mic_apps "$mic_apps" \
      --argjson camera "$camera" --arg camera_apps "$camera_apps" --argjson dnd "$dnd" \
      --argjson headphone "$headphone" \
      '{mic:$mic,mic_apps:$mic_apps,camera:$camera,camera_apps:$camera_apps,dnd:$dnd,headphone:$headphone}')
    if [[ $json != "$last" ]]; then printf '%s\n' "$json"; last=$json; fi
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
