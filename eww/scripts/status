#!/usr/bin/env bash
# status: mic, camera, DND and headphone state as one JSON line per change, for the island.
# One worker per event stream (pactl, inotify, dbus, bluez) reports {"source":...} lines;
# main merges them and prints once every source reported.
# shellcheck source-path=SCRIPTDIR
declare -g DIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/monitor.sh
source "$DIR/lib/monitor.sh"
# shellcheck source=lib/status/mic.sh
source "$DIR/lib/status/mic.sh"
# shellcheck source=lib/status/camera.sh
source "$DIR/lib/status/camera.sh"
# shellcheck source=lib/status/dnd.sh
source "$DIR/lib/status/dnd.sh"
# shellcheck source=lib/status/headphone.sh
source "$DIR/lib/status/headphone.sh"

# pactl feeds both the microphone and the headphone.
audio_snapshot() { mic_snapshot; headphone_snapshot; }
audio_event() { mic_event "$1"; headphone_sink_event "$1"; }
audio_idle() { mic_idle; headphone_idle; }
bluez_snapshot() { headphone_snapshot; }
bluez_event() { headphone_bluez_event "$1"; }
# The audio worker alone reports the headphone without bluez.
bluez_idle() { :; }

# stop_monitor: a worker's EXIT trap; ends the running monitor command.
stop_monitor() {
  [[ -n $monitor_pid ]] || return 0
  kill "$monitor_pid" 2>/dev/null || :
  wait "$monitor_pid" 2>/dev/null || :
}

# source_worker SOURCE TOOL... -- CMD...: SOURCE_snapshot each time CMD (re)starts, SOURCE_event
# for each CMD line, forever. A missing TOOL reports SOURCE_idle once instead.
source_worker() {
  local source=$1
  shift
  trap 'exit 0' TERM INT HUP
  trap stop_monitor EXIT
  while [[ $1 != -- ]]; do
    if ! require "$1"; then
      printf 'status: sumber %s dilewati, %s tidak tersedia\n' "$source" "$1" >&2
      "${source}_idle"
      return 0
    fi
    shift
  done
  shift
  monitor_start=${source}_snapshot
  run_forever monitor_run "${source}_event" "$@"
}

audio_worker() { source_worker audio pactl -- pactl subscribe; }
camera_worker() {
  camera_find || { camera_idle; return 0; }
  source_worker camera inotifywait find -- inotifywait -m -q -e open,close "${camera_devices[@]}"
}
dnd_worker() { source_worker dnd dunstctl dbus-monitor -- dbus-monitor --session "${DND_MATCH[@]}"; }
bluez_worker() { source_worker bluez gdbus -- gdbus monitor --system --dest org.bluez; }

main() {
  require jq || { printf 'status: jq tidak tersedia\n' >&2; return 127; }
  local events source line active apps headphone=$HEADPHONE_NONE json last='' initialized=0
  local mic=false mic_apps='' camera=false camera_apps='' dnd=false
  local -A seen=()
  exec {events}<> <(:)
  trap 'exit 0' TERM INT HUP
  trap workers_stop EXIT
  workers_start audio_worker camera_worker dnd_worker bluez_worker >&"$events"
  while IFS= read -r -u "$events" line; do
    IFS=$'\x1f' read -r source active apps json < <(jq -r \
      '[.source, (.active | tostring), (.apps // ""), (.headphone | tojson)] | join("\u001f")' <<< "$line")
    case $source in
      mic) mic=$active mic_apps=$apps ;;
      camera) camera=$active camera_apps=$apps ;;
      dnd) dnd=$active ;;
      headphone) headphone=$json ;;
      *) continue ;;
    esac
    if [[ ! ${seen[$source]:-} ]]; then
      seen[$source]=1
      initialized=$((initialized + 1))
    fi
    (( initialized == 4 )) || continue
    json=$(jq -cn --argjson mic "$mic" --arg mic_apps "$mic_apps" \
      --argjson camera "$camera" --arg camera_apps "$camera_apps" --argjson dnd "$dnd" \
      --argjson headphone "$headphone" \
      '{mic:$mic,mic_apps:$mic_apps,camera:$camera,camera_apps:$camera_apps,dnd:$dnd,headphone:$headphone}')
    if [[ $json != "$last" ]]; then printf '%s\n' "$json"; last=$json; fi
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
