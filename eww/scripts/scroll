#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$DIR/lib.sh"

main() {
  if [[ $# != 1 || ( $1 != up && $1 != down ) ]]; then
    printf 'Penggunaan: scroll up|down\n' >&2
    return 2
  fi
  require pactl || return 127
  local raw volume step=5 state="${XDG_RUNTIME_DIR:-/tmp}/eww-island"
  [[ $1 == down ]] && step=-5
  mkdir -p "$state" || return
  exec 9>"$state/scroll.lock"
  flock 9 || return
  raw=$(pactl get-sink-volume @DEFAULT_SINK@) || return
  [[ $raw =~ ([0-9]+)% ]] || return 1
  volume=$((10#${BASH_REMATCH[1]} + step))
  (( volume < 0 )) && volume=0
  (( volume > 100 )) && volume=100
  pactl set-sink-mute @DEFAULT_SINK@ 0 || return
  pactl set-sink-volume @DEFAULT_SINK@ "$volume%"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
