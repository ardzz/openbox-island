#!/usr/bin/env bash
# ytm: YouTube Music like/dislike state and next track for the island while ytm-player is the shown player.
#   ytm                  listener: {"active":bool,"video_id":"…","like":"LIKE|DISLIKE|INDIFFERENT|",
#                                   "next_title":"…","next_artist":"…"}
#   ytm toggle-like      like the current track, or unlike it when already liked
#   ytm toggle-dislike   dislike the current track, or undo the dislike
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"

YTM=${OB_YTM_CLI:-ytm}
HELPER=${OB_YTM_HELPER:-$DIR/ytm_like.py}
RETRY=${OB_YTM_RETRY:-0.5}

# shellcheck source=lib/ytm/toggle.sh
source "$DIR/lib/ytm/toggle.sh"
# shellcheck source=lib/ytm/jobs.sh
source "$DIR/lib/ytm/jobs.sh"

ytm_is_player() { [[ $1 == ytm_player || $1 == ytm_player.* ]]; }

listener_cleanup() {
  # A signal during `IFS=$'\t' read` leaves that IFS in effect here; split job pids on newlines.
  local IFS=$'\n' pids
  pids=$(jobs -p)
  # shellcheck disable=SC2086
  [[ -z $pids ]] || kill $pids 2>/dev/null
  rm -rf -- "$work"
}

listen() {
  local work events watch='' kind a b c gen=0 key='' vid='' api=1 last=''
  local player media_key title state next_title='""' next_artist='""'
  local -A cache=() pending=()
  emit() {
    local json='{"active":false,"video_id":"","like":"","next_title":"","next_artist":""}'
    if [[ -n $key && -n $vid ]] && (( api )); then
      printf -v json '{"active":true,"video_id":"%s","like":"%s","next_title":%s,"next_artist":%s}' \
        "$vid" "${cache[$vid]:-}" "$next_title" "$next_artist"
    elif [[ -n $key ]] && (( api )); then
      json='{"active":true,"video_id":"","like":"","next_title":"","next_artist":""}'
    fi
    [[ $json == "$last" ]] && return
    last=$json
    printf '%s\n' "$json" > "$ISLAND_STATE/ytm.json.tmp"
    mv "$ISLAND_STATE/ytm.json.tmp" "$ISLAND_STATE/ytm.json"
    printf '%s\n' "$json"
  }
  fetch() {
    [[ -n $vid && -z ${cache[$vid]+x} && -z ${pending[$vid]:-} ]] || return 0
    pending[$vid]=1
    like_job "$vid" > "$work/events" &
  }
  refresh() {
    player='' media_key='' title='' state=''
    [[ ! -r $ISLAND_STATE/player ]] || IFS= read -r player < "$ISLAND_STATE/player" || :
    { IFS= read -r state; IFS= read -r media_key; IFS= read -r title; } < <(
      jq -r '.state, ([.player, .title, .artist] | tojson), (.title | tojson)' "$ISLAND_STATE/media.json" 2>/dev/null)
    if ! ytm_is_player "$player" || [[ $state != playing && $state != paused ]]; then
      key='' vid='' next_title='""' next_artist='""'
    elif [[ $media_key != "$key" ]]; then
      key=$media_key vid='' next_title='""' next_artist='""'
      gen=$((gen + 1))
      (( api )) && resolve_job "$gen" "$title" > "$work/events" &
    fi
    emit
  }

  mkdir -p "$ISLAND_STATE"
  rm -f "$ISLAND_STATE/ytm_set"
  emit
  command -v "$YTM" >/dev/null 2>&1 || return 0
  if ! require jq inotifywait; then
    printf 'ytm: %s tidak tersedia, tombol suka dinonaktifkan\n' "$MISSING_DEP" >&2
    return 0
  fi
  work=$(mktemp -d "$ISLAND_STATE/ytm.XXXXXX") || return 0
  trap 'exit 0' TERM INT HUP
  trap listener_cleanup EXIT
  mkfifo "$work/events"
  exec {events}<> "$work/events"
  while true; do
    if [[ -z $watch ]] || ! kill -0 "$watch" 2>/dev/null; then
      [[ -z $watch ]] || wait "$watch" 2>/dev/null
      # stderr joins the FIFO: "Watches established." triggers the snapshot without a race.
      inotifywait -m -e close_write,moved_to --format 'state:%f' "$ISLAND_STATE" > "$work/events" 2>&1 &
      watch=$!
    fi
    IFS=$'\t' read -r -t 5 -u "$events" kind a b c || continue
    case $kind in
      'Watches established.'|state:media.json) refresh ;;
      state:ytm_set)
        IFS=$'\t' read -r a b < "$ISLAND_STATE/ytm_set" 2>/dev/null || continue
        cache[$a]=$b
        emit ;;
      vid)
        [[ $a == "$gen" && -n $key && $b =~ ^[A-Za-z0-9_-]{11}$ ]] || continue
        vid=$b
        emit
        fetch
        queue_job "$gen" "$vid" > "$work/events" & ;;
      next)
        [[ $a == "$gen" && -n $vid && $b == \"*\" && $c == \"*\" ]] || continue
        next_title=$b next_artist=$c
        emit ;;
      like)
        unset "pending[$a]"
        case $b in
          UNAVAILABLE) api=0; key=''; vid='' next_title='""' next_artist='""' ;;
          LIKE|DISLIKE|INDIFFERENT) [[ -n ${cache[$a]+x} ]] || cache[$a]=$b ;;
          *) continue ;;
        esac
        emit ;;
    esac
  done
}

main() {
  case ${1:-} in
    toggle-like) toggle like ;;
    toggle-dislike) toggle dislike ;;
    '') listen ;;
    *) printf 'pemakaian: %s [toggle-like|toggle-dislike]\n' "${0##*/}" >&2; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
