#!/usr/bin/env bash
# weather: current weather and forecast JSON for the island from wttr.in, cached between restarts.
# shellcheck source-path=SCRIPTDIR
declare -g DIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/weather/format.sh
source "$DIR/lib/weather/format.sh"
# shellcheck source=lib/weather/location.sh
source "$DIR/lib/weather/location.sh"
# shellcheck source=lib/weather/fetch.sh
source "$DIR/lib/weather/fetch.sh"

stream() {
  require curl jq || return 127
  local record='' fetched=0 cached now hour next_fetch=0 delay last_now temp code
  local interval=${ISLAND_WEATHER_INTERVAL:-1800} retry=${ISLAND_WEATHER_RETRY:-300}
  now=$(date +%s)
  last_now=$now
  hour=$(date +%H)
  cached=$(read_weather_cache)
  if [[ -n $cached ]]; then
    fetched=$(jq -r '.fetched' <<< "$cached")
    if (( now >= fetched && now - fetched < 10800 )); then
      record=$cached
      temp=$(jq -r '.temp_C' <<< "$record") code=$(jq -r '.weatherCode' <<< "$record")
      weather_json "$temp" "$code" "$hour" "$record"
      # eww restarts this listener whenever the island reopens: a fresh cache waits for its interval.
      if (( now - fetched < interval )); then next_fetch=$((fetched + interval)); fi
    fi
  fi
  while true; do
    now=$(date +%s)
    if (( now < last_now )); then
      next_fetch=$((next_fetch + now - last_now))
      fetched=$((fetched + now - last_now))
    fi
    last_now=$now
    hour=$(date +%H)
    if (( now >= next_fetch )); then
      if cached=$(fetch_weather); then
        record=$cached
        temp=$(jq -r '.temp_C' <<< "$record") code=$(jq -r '.weatherCode' <<< "$record")
        now=$(date +%s)
        hour=$(date +%H)
        fetched=$now
        cached=$(jq -c --argjson fetched "$fetched" '. + {fetched:$fetched}' <<< "$record")
        write_weather_cache "$CACHE" "$cached" || :
        next_fetch=$((now + interval))
      else
        now=$(date +%s)
        if (( now < last_now )); then fetched=$((fetched + now - last_now)); fi
        hour=$(date +%H)
        next_fetch=$((now + retry))
      fi
    fi
    if [[ -n $record ]] && (( now >= fetched && now - fetched < 10800 )); then
      weather_json "$temp" "$code" "$hour" "$record"
    else
      printf '%s\n' "$NONE_JSON"
    fi
    delay=$((next_fetch - now))
    last_now=$now
    (( delay <= 60 )) || delay=60
    sleep "$delay"
  done
}

main() { run_forever stream | emit_dedup; }

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
