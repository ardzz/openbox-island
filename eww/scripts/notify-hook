#!/usr/bin/env bash
# dunst rule script (dunst-osd.conf): hand each notification to the island's listeners.
# dunst runs it asynchronously with DUNST_* variables; it never waits for the listener.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/notify/clean.sh
source "$DIR/lib/notify/clean.sh"
# shellcheck source=lib/notify/history.sh
source "$DIR/lib/notify/history.sh"

main() {
  local icon=${DUNST_ICON_PATH:-} app summary body urgency entry tag line
  # Field limits keep the line below PIPE_BUF (4096 bytes), so concurrent hooks never interleave.
  field app "${DUNST_APP_NAME:-}" 80
  field entry "${DUNST_DESKTOP_ENTRY:-}" 80
  # dunst history has no desktop entry: scripts/notif click looks it up here.
  desktop_remember "${DUNST_ID:-}" "$app" "$entry"
  # The notification center rereads dunst history once dunst has stored this one.
  notif_signal '@refresh'
  [[ -p $ISLAND_STATE/notify.fifo ]] || return 0
  field summary "${DUNST_SUMMARY:-}" 120
  field body "${DUNST_BODY:-}" 240
  field urgency "${DUNST_URGENCY:-}" 16
  field tag "${DUNST_STACK_TAG:-}" 80
  # A path is kept whole or dropped.
  if [[ $icon == *[[:cntrl:]]* ]] || (( ${#icon} > 255 )); then icon=''; fi
  line=$(jq -cn --arg id "${DUNST_ID:-}" --arg app "$app" --arg summary "$summary" --arg body "$body" \
    --arg icon "$icon" --arg urgency "$urgency" --arg entry "$entry" --arg tag "$tag" \
    '{id:(($id | tonumber?) // 0),app:$app,summary:$summary,body:$body,icon:$icon,urgency:$urgency,entry:$entry,tag:$tag}') || return 0
  notify_signal "$line"
}

main "$@"
