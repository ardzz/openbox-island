#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
OMP="${OB_OMP:-$(command -v omp || printf '%s' "$HOME/.bun/bin/omp")}"

fetch_kuota() {
  [[ -x $OMP ]] || { MISSING_DEP=omp; return 127; }
  require jq || return 127
  local raw now updated zone tz cli_path=$PATH
  [[ ! -d $HOME/.bun/bin ]] || cli_path="$HOME/.bun/bin:$PATH"
  raw=$(PATH="$cli_path" "$OMP" usage --json --no-extensions) || return
  now=${ISLAND_NOW:-$(date +%s)}
  updated=$(date -d "@$now" +%H:%M)
  zone=$(date -d "@$now" +%z)
  tz=$(( (10#${zone:1:2} * 3600 + 10#${zone:3:2} * 60) * ${zone:0:1}1 ))
  jq -cse --arg skip "${ISLAND_KUOTA_SKIP-google-antigravity}" \
    --arg updated "$updated" --argjson now "$now" --argjson tz "$tz" '
    def provider_name:
      {"openai-codex":"Codex", "anthropic":"Claude", "github-copilot":"Copilot",
       "google-antigravity":"Antigravity"}[.] // .;
    def translate_label:
      sub("^Claude "; "") | gsub("[Hh]ours?"; "jam") | gsub("[Dd]ays?"; "hari") |
      if . == "Premium Requests" then "Permintaan premium" else . end;
    def reset_text:
      if . == null then "—"
      else (. / 1000 - $now | floor) as $seconds |
        if $seconds <= 0 then "segera"
        elif $seconds < 3600 then "\(($seconds / 60 | floor))m"
        elif $seconds < 86400 then
          "\(($seconds / 3600 | floor))j" +
          (if ($seconds % 3600 / 60 | floor) == 0 then ""
           else " \(($seconds % 3600 / 60 | floor))m" end)
        else "\(($seconds / 86400 | floor)) hr" end
    end;
    def text: if type == "string" then . else "" end;
    def identity($email; $org):
      if .provider != "anthropic" then ""
      else ($email | text) as $e | ($org | text) as $o |
        if $e != "" and $o != "" then "\($e) (\($o))" else $e + $o end
      end;
    # omp serves a cached report when a refresh fails; name its age past 15 minutes.
    def stale_text:
      if (.fetchedAt | type) == "number" and $now - .fetchedAt / 1000 > 900
      then "data omp " + (.fetchedAt / 1000 + $tz | floor | gmtime | strftime("%H:%M"))
      else "" end;
    # 999, 1.5K, 12.5K, 120K, 2M: one decimal below 100 of the unit.
    def short:
      def one: if . >= 99.95 then round else . * 10 | round / 10 end | tostring | sub("\\.0$"; "");
      if . >= 999500 then (. / 1000000 | one) + "M"
      elif . >= 999.5 then (. / 1000 | one) + "K"
      else round | tostring end;
    # Percent windows carry .used; counted ones (Copilot requests) carry a limit or a fraction.
    def counted: .limit | type == "number" and . > 0;
    def used_pct:
      if .unit == "percent" then (if (.used | type) == "number" then .used else -1 end)
      elif (.usedFraction | type) == "number" then .usedFraction * 100
      elif counted and (.used | type) == "number" then .used * 100 / .limit
      else -1 end;
    # Whole counts only: money (usd) and fractional credits would round into nonsense.
    def count_text:
      if .unit != "percent" and .unit != "usd" and counted and (.used | type) == "number"
         and .used == (.used | floor) and .limit == (.limit | floor)
      then "\(.used | short)/\(.limit | short)" else "" end;
    if length != 1 then error("expected one usage report") else .[0] end |
    if (.reports | type) != "array" then error("missing reports") else . end |
    ($skip | split(",")) as $skipped |
    def kept: .provider as $provider | select(any($skipped[]; . == $provider) | not);
    {ok:true, updated:$updated, fetched:$now, note:"", accounts:[
      (.reports[] | kept |
       {provider:(.provider | provider_name), plan:(.metadata.planType // .metadata.plan // ""),
        identity:identity(.metadata.email; .metadata.orgName), status:stale_text, limits:[
         .limits[] | {label:(.label | translate_label),
           used:(.amount | used_pct), count:(.amount | count_text),
           reset:(.window.resetsAt | reset_text)}
       ]}),
      (if (.accountsWithoutUsage | type) == "array" then .accountsWithoutUsage[] else empty end |
       kept | {provider:(.provider | provider_name), plan:"", identity:identity(.email; .orgName),
               status:"tidak ada data", limits:[]})
    ]}
  ' <<< "$raw"
}

stream() {
  local record='' result temp note fetched now
  local interval=${ISLAND_KUOTA_INTERVAL:-300}
  [[ $interval =~ ^[0-9]+$ && $interval =~ [1-9] ]] || interval=300
  interval=$((10#$interval))
  if record=$(jq -ce 'select(.ok == true)' "$ISLAND_STATE/kuota.json" 2>/dev/null); then
    printf '%s\n' "$record"
    fetched=$(jq -r '.fetched // 0' <<< "$record")
    now=${ISLAND_NOW:-$(date +%s)}
    if [[ $fetched =~ ^[0-9]+$ ]] && (( fetched > 0 && fetched <= now && now - fetched < interval )); then
      sleep "$((interval - (now - fetched)))"
    fi
  else
    record=''
  fi
  while true; do
    if result=$(fetch_kuota 2>/dev/null); then
      record=$result
      mkdir -p "$ISLAND_STATE"
      if temp=$(mktemp "$ISLAND_STATE/kuota.json.XXXXXX"); then
        printf '%s\n' "$record" > "$temp" && mv -f "$temp" "$ISLAND_STATE/kuota.json"
        rm -f "$temp"
      fi
    elif [[ -z $record ]]; then
      note='gagal memuat kuota'
      [[ -x $OMP ]] || note='omp tidak ditemukan'
      printf '{"ok":false,"updated":"","note":"%s","accounts":[]}\n' "$note"
    fi
    [[ -z $record ]] || printf '%s\n' "$record"
    sleep "$interval"
  done
}

main() { stream | emit_dedup; }
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
