#!/usr/bin/env bash
# island hover | auto SECONDS | close | hide | show
# Opens/closes the expanded island; hide/show close and restore both windows for
# scripts/fullscreen. State: auto_until (epoch seconds until which an auto-expand holds the
# island open), fullscreen (present while hidden). Whether the island is hovered is read from
# the pointer itself: eww's onhover/onhoverlost also fire on pointer grabs and reach this
# script in no reliable order, so they only trigger a re-check.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$DIR/lib.sh"
CFG="${DIR%/scripts}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/eww-island"
REVEAL_SECONDS=0.3
HOVER_SECONDS=0.3

# Keep the lock fd out of eww: a daemon auto-started by `eww open` would hold it forever.
eww() { command eww --config "$CFG" "$@" 9>&-; }
lock() { mkdir -p "$STATE"; exec 9>"$STATE/lock"; flock 9; }
unlock() { exec 9>&-; }
get() { local v; v=$(cat "$STATE/$1" 2>/dev/null); printf '%s\n' "${v:-0}"; }
put() { printf '%s\n' "$2" > "$STATE/$1"; }
is_open() { eww active-windows 2>/dev/null | sed -n 's/^[^:]*: *//p' | grep -qx island-expanded; }

# hovered: the pointer is inside a visible island window (compact or expanded) right now.
hovered() {
  local k v px='' py='' x=0 y=0 w=0
  while IFS='=' read -r k v; do
    case $k in X) px=$v ;; Y) py=$v ;; esac
  done < <(xdotool getmouselocation --shell 2>/dev/null)
  [[ $px =~ ^[0-9]+$ && $py =~ ^[0-9]+$ ]] || return 1
  while IFS='=' read -r k v; do
    case $k in
      X) x=$v ;;
      Y) y=$v ;;
      WIDTH) w=$v ;;
      HEIGHT) (( px >= x && px < x + w && py >= y && py < y + v )) && return 0 ;;
    esac
  done < <(xdotool search --onlyvisible --name '^Eww - island(-expanded)?$' getwindowgeometry --shell %@ 2>/dev/null)
  return 1
}

# expand [TAB]: open the card on `tab resolve [TAB]`; an explicit TAB also switches an open card.
expand() {
  [[ ! -e $STATE/fullscreen ]] || return 0
  if ! is_open; then
    put marquee_at "$(date +%s%1N)"
    eww update island_reveal=false "island_tab=$("$DIR/tab" resolve "$@")"
    eww open island-expanded
    eww update island_reveal=true
  elif (( $# )); then
    eww update "island_tab=$("$DIR/tab" resolve "$1")" island_reveal=true
  else
    eww update island_reveal=true
  fi
  # The compact pill is hidden now: notifications wait until it returns.
  notify_signal '@expanded 1'
  notif_signal '@expanded 1'
}

collapse() {
  is_open || return 0
  eww update island_reveal=false
  sleep "$REVEAL_SECONDS"
  # The window is still mapped while hiding: a pointer that came back gets no new enter event.
  if hovered; then eww update island_reveal=true; return 0; fi
  eww close island-expanded
  notify_signal '@expanded 0'
  notif_signal '@expanded 0'
}

# collapse_if_idle: collapse unless the pointer is on the island or an auto-expand still holds it.
collapse_if_idle() {
  if (( $(date +%s) >= $(get auto_until) )) && ! hovered; then collapse; fi
}

# hide: close both windows until show. eww stops every listener only these windows use.
hide() {
  [[ ! -e $STATE/fullscreen ]] || return 0
  : > "$STATE/fullscreen"
  put auto_until 0
  if is_open; then
    eww update island_reveal=false
    eww close island-expanded
    notify_signal '@expanded 0'
    notif_signal '@expanded 0'
  fi
  eww close island
}

# show: bring the compact island back after hide. Never auto-starts a stopped daemon.
show() {
  [[ -e $STATE/fullscreen ]] || return 0
  rm -f "$STATE/fullscreen"
  if eww ping >/dev/null 2>&1; then eww open island; fi
}

usage() { echo "usage: island hover | auto SECONDS | close | hide | show" >&2; return 2; }

main() {
  case $1 in
    hover)
      # The 508px compact notch overlaps browser tabs; ignore pointers just passing through.
      if ! is_open; then sleep "$HOVER_SECONDS"; fi
      # Re-check after expanding: a pointer that left while opening gets no leave event.
      lock; if hovered; then expand; fi; collapse_if_idle ;;
    auto)
      [[ $2 =~ ^[0-9]+$ ]] || { usage; return; }
      local secs
      secs=$(( 10#$2 ))
      lock; put auto_until $(( $(date +%s) + secs )); expand musik; unlock
      ( sleep "$secs"; lock; collapse_if_idle ) >/dev/null 2>&1 & ;;
    close)
      # The player went away: a card kept open by the pointer falls back to another tab.
      lock; put auto_until 0; collapse_if_idle
      if is_open; then eww update "island_tab=$("$DIR/tab" resolve)"; fi ;;
    hide) lock; hide ;;
    show) lock; show ;;
    *) usage ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
