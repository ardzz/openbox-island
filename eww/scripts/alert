#!/usr/bin/env bash
# alert: one JSON line per transient alert or HUD, cleared after its hold. Sources live in lib/alert/.
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/monitor.sh
source "$DIR/lib/monitor.sh"

# Worker start order; lib/alert/worker.sh describes what each lib/alert/NAME.sh defines.
ALERT_SOURCES=(audio brightness battery wifi bluetooth screenshot temperature capslock power conservation vpn deadline meeting prep)
for lib in common worker output "${ALERT_SOURCES[@]}"; do
  # shellcheck source=/dev/null
  source "$DIR/lib/alert/$lib.sh"
done
CLEAR_JSON='{"kind":"","icon":"","text":"","value":"","level":-1,"image":""}'

listener_cleanup() {
  workers_stop
  rm -rf -- "$workdir"
}

main() {
  require jq || { printf 'alert: jq tidak tersedia\n' >&2; return 127; }
  local workdir alert_source input_fd
  local line current='' last=$CLEAR_JSON deadline=0 now remaining timeout kind hold
  local hud_us alert_us
  hud_us=$(seconds_us "${ISLAND_HUD_SECONDS:-1.5}")
  alert_us=$(seconds_us "${ISLAND_ALERT_SECONDS:-3}")
  mkdir -p "$ISLAND_STATE"
  workdir=$(mktemp -d "$ISLAND_STATE/alert.XXXXXX") || return
  trap 'exit 0' TERM INT HUP
  trap listener_cleanup EXIT
  mkfifo "$workdir/events"
  exec {input_fd}<> "$workdir/events"
  printf '%s\n' "$CLEAR_JSON"
  # shellcheck disable=SC2034 # each source_worker reads its alert_source
  for alert_source in "${ALERT_SOURCES[@]}"; do
    workers_start source_worker > "$workdir/events"
  done
  while true; do
    if (( deadline )); then
      now=${EPOCHREALTIME/./}
      remaining=$((deadline - now))
      if (( remaining <= 0 )); then
        if [[ $last != "$CLEAR_JSON" ]]; then printf '%s\n' "$CLEAR_JSON"; notify_signal '@alert 0'; fi
        last=$CLEAR_JSON current='' deadline=0
        continue
      fi
      printf -v timeout '%d.%06d' "$((remaining / 1000000))" "$((remaining % 1000000))"
      IFS= read -r -t "$timeout" -u "$input_fd" line || continue
    else
      IFS= read -r -u "$input_fd" line || continue
    fi
    # '@refresh KIND' follows each audio or brightness event: it extends that HUD only while it shows.
    if [[ $line == '@refresh '* ]]; then
      kind=${line#@refresh }
      [[ $current == "$kind" ]] || continue
    else
      [[ $line =~ \"kind\":\"([^\"]+)\" ]] || continue
      kind=${BASH_REMATCH[1]}
      current=$kind
      if [[ $line != "$last" ]]; then
        printf '%s\n' "$line"
        # The notification listener pauses its hold while an alert covers it.
        [[ $last != "$CLEAR_JSON" ]] || notify_signal '@alert 1'
        last=$line
      fi
    fi
    case $kind in
      volume|mic|brightness|capslock) hold=$hud_us ;;
      *) hold=$alert_us ;;
    esac
    now=${EPOCHREALTIME/./}
    deadline=$((now + hold))
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
