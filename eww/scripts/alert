#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$DIR/lib.sh"

ICON_VOL_MUTED=$'\U000F0581'
ICON_VOL_LOW=$'\uF026'
ICON_VOL_MID=$'\uF027'
ICON_VOL_HIGH=$'\uF028'
ICON_MIC=$'\U000F036C'
ICON_MIC_MUTED=$'\U000F036D'
ICON_BRI_LOW=$'\U000F00DE'
ICON_BRI_MID=$'\U000F00DF'
ICON_BRI_HIGH=$'\U000F00E0'
ICON_BAT_LOW=$'\U000F12A1'
ICON_BAT_FULL=$'\U000F0079'
ICON_BAT_CHARGING=$'\U000F0084'
ICON_WIFI_4=$'\U000F0928'
ICON_WIFI_OFF=$'\U000F092D'
ICON_BT=$'\U000F00AF'
ICON_HEADPHONES=$'\U000F02CB'
ICON_GAMEPAD=$'\U000F0297'
ICON_MOUSE=$'\U000F037D'
ICON_KEYBOARD=$'\U000F030C'
ICON_PHONE=$'\U000F011C'
ICON_CAMERA=$'\U000F0100'
ICON_THERMOMETER=$'\U000F050F'
CLEAR_JSON='{"kind":"","icon":"","text":"","value":"","level":-1,"image":""}'
BT_CONNECTED_RE="^/org/bluez/hci[0-9]+/dev_([0-9A-Fa-f_]{17}): org\\.freedesktop\\.DBus\\.Properties\\.PropertiesChanged \\('org\\.bluez\\.Device1', \\{.*'Connected': <(true|false)>"
declare -gA wifi_states=() bt_states=() temp_inputs=() temp_states=()

level_icon() {
  if (( $1 < 34 )); then printf '%s' "$2"
  elif (( $1 < 67 )); then printf '%s' "$3"
  else printf '%s' "$4"; fi
}

# alert_json KIND ICON TEXT VALUE LEVEL [IMAGE_PATH]: the image becomes a percent-encoded file URI for CSS url().
alert_json() {
  jq -cn --arg kind "$1" --arg icon "$2" --arg text "$3" \
    --arg value "$4" --argjson level "$5" --arg image "${6:-}" \
    '{kind:$kind,icon:$icon,text:$text,value:$value,level:$level,
      image:(if $image == "" then "" else "file://" + ($image | split("/") | map(@uri) | join("/")) end)}'
}

audio_update() {
  local volume=$1 mute=$2 mic=$3 icon text
  if [[ -n ${audio_seen:-} ]]; then
    if [[ $volume != "$audio_volume" || $mute != "$audio_mute" ]]; then
      icon=$ICON_VOL_MUTED text=Bisu
      if [[ $mute == no ]]; then
        icon=$(level_icon "$volume" "$ICON_VOL_LOW" "$ICON_VOL_MID" "$ICON_VOL_HIGH")
        text=Volume
      fi
      alert_json volume "$icon" "$text" "$volume%" "$volume"
    fi
    if [[ $mic != "$audio_mic" ]]; then
      icon=$ICON_MIC text='Mikrofon nyala'
      if [[ $mic == yes ]]; then icon=$ICON_MIC_MUTED text='Mikrofon mati'; fi
      alert_json mic "$icon" "$text" '' -1
    fi
  fi
  audio_seen=1 audio_volume=$volume audio_mute=$mute audio_mic=$mic
}

audio_read() {
  local raw
  raw=$(pactl get-sink-volume @DEFAULT_SINK@) || return
  [[ $raw =~ ([0-9]+)% ]] || return 1
  sample_volume=$((10#${BASH_REMATCH[1]}))
  raw=$(pactl get-sink-mute @DEFAULT_SINK@) || return
  [[ $raw =~ Mute:[[:space:]]+(yes|no) ]] || return 1
  sample_mute=${BASH_REMATCH[1]}
  raw=$(pactl get-source-mute @DEFAULT_SOURCE@) || return
  [[ $raw =~ Mute:[[:space:]]+(yes|no) ]] || return 1
  sample_mic=${BASH_REMATCH[1]}
}

audio_snapshot() {
  audio_read || return
  audio_update "$sample_volume" "$sample_mute" "$sample_mic"
}

audio_event() {
  local target
  case $1 in
    *' on sink #'*) target=volume ;;
    *' on source #'*) target=mic ;;
    *' on server'*) target=both ;;
    *) return 0 ;;
  esac
  audio_snapshot || return
  if [[ ${worker_mode:-0} == 1 ]]; then
    [[ $target == mic ]] || printf '@refresh volume\n'
    [[ $target == volume ]] || printf '@refresh mic\n'
  fi
}

brightness_update() {
  local value=${1%%.*} icon
  [[ $value =~ ^[0-9]+$ ]] || return 0
  value=$((10#$value))
  if [[ -n ${brightness_seen:-} && $value != "$brightness_value" ]]; then
    icon=$(level_icon "$value" "$ICON_BRI_LOW" "$ICON_BRI_MID" "$ICON_BRI_HIGH")
    alert_json brightness "$icon" Kecerahan "$value%" "$value"
  fi
  brightness_seen=1 brightness_value=$value
}

brightness_snapshot() {
  local value
  value=$(light -G) || return
  brightness_update "$value"
}

brightness_event() {
  [[ $1 == UDEV* ]] || return 0
  brightness_snapshot || return
  if [[ ${worker_mode:-0} == 1 ]]; then printf '@refresh brightness\n'; fi
}

battery_update() {
  local state=$1 value=$2 text='' icon=$ICON_BAT_FULL kind=battery
  if [[ -n ${battery_seen:-} ]]; then
    if [[ $state != "$battery_state" ]]; then
      case $state in
        charging) text='Mengisi daya'; icon=$ICON_BAT_CHARGING; kind=charging ;;
        fully-charged) text='Baterai penuh' ;;
        discharging)
          case $battery_state in
            charging|pending-charge|fully-charged) text='Charger dicabut' ;;
          esac ;;
      esac
    fi
    if [[ -n $text ]]; then alert_json "$kind" "$icon" "$text" "$value%" "$value"; fi
    if [[ $state == discharging ]]; then
      text='' kind=battery-low icon=$ICON_BAT_LOW
      if (( battery_value > 10 && value <= 10 )); then text='Baterai kritis'
      elif (( battery_value > 20 && value <= 20 )); then text='Baterai lemah'; fi
      if [[ -n $text ]]; then alert_json "$kind" "$icon" "$text" "$value%" "$value"; fi
    fi
  fi
  battery_seen=1 battery_state=$state battery_value=$value
}

battery_snapshot() {
  local raw line state='' value=''
  raw=$(upower -i "$battery_path") || return
  while IFS= read -r line; do
    if [[ $line =~ state:[[:space:]]+([^[:space:]]+) ]]; then state=${BASH_REMATCH[1]}; fi
    if [[ $line =~ percentage:[[:space:]]+([0-9]+([.][0-9]+)?)% ]]; then value=${BASH_REMATCH[1]}; fi
  done <<< "$raw"
  [[ -n $state && -n $value ]] || return 1
  value=${value%%.*}
  battery_update "$state" "$((10#$value))"
}

battery_event() {
  [[ $1 == *'device changed:'* && $1 == *"$battery_path"* ]] || return 0
  battery_snapshot
}

wifi_snapshot() {
  local devices dev type state
  devices=$(nmcli -t -f DEVICE,TYPE device) || return
  while IFS=: read -r dev type; do
    [[ $type == wifi ]] || continue
    state=$(nmcli -t -g GENERAL.STATE device show "$dev") || continue
    if [[ $state == '100 '* || $state == 100 || $state == connected ]]; then
      wifi_states[$dev]=connected
    else
      wifi_states[$dev]=disconnected
    fi
  done <<< "$devices"
}

wifi_event() {
  local dev=${1%%:*} state=${1#*: } connection='' icon text
  [[ -n ${wifi_states[$dev]+set} ]] || return 0
  case $state in
    connected) icon=$ICON_WIFI_4; text='Wi-Fi tersambung' ;;
    disconnected) icon=$ICON_WIFI_OFF; text='Wi-Fi terputus' ;;
    *) return 0 ;;
  esac
  [[ $state != "${wifi_states[$dev]}" ]] || return 0
  wifi_states[$dev]=$state
  if [[ $state == connected ]]; then
    connection=$(nmcli -t -g GENERAL.CONNECTION device show "$dev") || return
  fi
  alert_json wifi "$icon" "$text" "$connection" -1
}

bluetooth_snapshot() {
  local devices word mac rest
  # bluetoothctl waits forever for bluetoothd when the daemon is down.
  devices=$(timeout 3 bluetoothctl devices Connected) || return
  bt_states=()
  while read -r word mac rest; do
    if [[ $word == Device ]]; then bt_states[$mac]=yes; fi
  done <<< "$devices"
}

bluetooth_event() {
  local mac state info line alias='' device='' battery='' icon text
  [[ $1 =~ $BT_CONNECTED_RE ]] || return 0
  mac=${BASH_REMATCH[1]//_/:} state=no
  if [[ ${BASH_REMATCH[2]} == true ]]; then state=yes; fi
  [[ $state != "${bt_states[$mac]:-no}" ]] || return 0
  bt_states[$mac]=$state
  info=$(timeout 3 bluetoothctl info "$mac") || info=''
  while read -r line; do
    case $line in
      'Alias: '*) alias=${line#Alias: } ;;
      'Icon: '*) device=${line#Icon: } ;;
      'Battery Percentage: '*) if [[ $line =~ \(([0-9]+)\) ]]; then battery=${BASH_REMATCH[1]}; fi ;;
    esac
  done <<< "$info"
  alias=${alias:-$mac}
  case $device in
    audio-*|*headset*) icon=$ICON_HEADPHONES ;;
    input-gaming) icon=$ICON_GAMEPAD ;;
    input-mouse) icon=$ICON_MOUSE ;;
    input-keyboard) icon=$ICON_KEYBOARD ;;
    phone) icon=$ICON_PHONE ;;
    *) icon=$ICON_BT ;;
  esac
  text='Bluetooth terputus'
  if [[ $state == yes ]]; then
    text='Bluetooth tersambung'
    if [[ -n $battery ]]; then alias+=" · $battery%"; fi
  fi
  alert_json bluetooth "$icon" "$text" "$alias" -1
}

screenshot_dir() {
  local pictures=''
  if [[ -n ${ISLAND_SCREENSHOT_DIR:-} ]]; then
    printf '%s\n' "$ISLAND_SCREENSHOT_DIR"
    return
  fi
  if command -v xdg-user-dir > /dev/null 2>&1; then
    pictures=$(xdg-user-dir PICTURES 2>/dev/null) || pictures=''
  fi
  # xdg-user-dir answers $HOME when PICTURES is not configured.
  if [[ -z $pictures || ${pictures%/} == "${HOME%/}" ]]; then pictures=$HOME/Pictures; fi
  printf '%s\n' "${pictures%/}/Screenshots"
}

screenshot_snapshot() { :; }

screenshot_event() {
  case ${1,,} in
    *.png|*.jpg|*.jpeg) alert_json screenshot "$ICON_CAMERA" 'Tangkapan layar' "${1##*/}" -1 "$1" ;;
  esac
}

# temperature_find: pick the CPU and GPU hwmon inputs by label. Fails when neither exists.
temperature_find() {
  local file label
  local -A inputs=()
  temp_inputs=() temp_states=()
  for file in "${ISLAND_HWMON:-/sys/class/hwmon}"/hwmon*/temp*_label; do
    label=''
    IFS= read -r label 2>/dev/null < "$file" || :
    [[ -n $label && -z ${inputs[$label]:-} ]] || continue
    inputs[$label]=${file%_label}_input
  done
  for label in 'CPU Temperature' 'Package id 0' Tctl; do
    if [[ -n ${inputs[$label]:-} ]]; then temp_inputs[cpu]=${inputs[$label]}; break; fi
  done
  if [[ -n ${inputs['GPU Temperature']:-} ]]; then temp_inputs[gpu]=${inputs['GPU Temperature']}; fi
  (( ${#temp_inputs[@]} ))
}

# temperature_update SENSOR MILLIDEGREES: warn on reaching the threshold, re-arm 5 °C below it.
temperature_update() {
  local sensor=$1 celsius threshold=${ISLAND_TEMP_GPU:-87} text='GPU panas'
  [[ $2 =~ ^[0-9]+$ ]] || return 0
  celsius=$((10#$2 / 1000))
  if [[ $sensor == cpu ]]; then threshold=${ISLAND_TEMP_CPU:-95} text='CPU panas'; fi
  case ${temp_states[$sensor]:-} in
    armed)
      if (( celsius >= threshold )); then
        temp_states[$sensor]=hot
        alert_json temperature "$ICON_THERMOMETER" "$text" "${celsius}°C" -1
      fi ;;
    hot) if (( celsius < threshold - 5 )); then temp_states[$sensor]=armed; fi ;;
    *) temp_states[$sensor]=armed; if (( celsius >= threshold )); then temp_states[$sensor]=hot; fi ;;
  esac
}

temperature_snapshot() {
  local sensor value
  for sensor in cpu gpu; do
    [[ -n ${temp_inputs[$sensor]:-} ]] || continue
    value=''
    IFS= read -r value 2>/dev/null < "${temp_inputs[$sensor]}" || :
    temperature_update "$sensor" "$value"
  done
}

# poll_sleep SECONDS: sleep without forking by timing out a read on a pipe nobody writes to.
poll_sleep() {
  if [[ -z ${sleep_fd:-} ]]; then exec {sleep_fd}<> <(:); fi
  read -r -t "$1" -u "$sleep_fd" || :
}

stop_children() {
  local pid
  if [[ -n ${monitor_pid:-} ]]; then kill "$monitor_pid" 2>/dev/null || :; fi
  while read -r pid; do kill "$pid" 2>/dev/null || :; done < <(jobs -pr)
  wait 2>/dev/null || :
}

monitor_stream() {
  local handler=$1 line fd
  shift
  coproc EVENT_MONITOR { exec "$@"; }
  monitor_pid=$EVENT_MONITOR_PID
  fd=${EVENT_MONITOR[0]}
  "${handler%_event}_snapshot" > /dev/null
  while IFS= read -r -u "$fd" line; do "$handler" "$line"; done
  wait "$monitor_pid" 2>/dev/null || :
  monitor_pid=''
}

source_worker() {
  local source=$1 tool path
  worker_mode=1
  trap 'exit 0' TERM INT HUP
  trap stop_children EXIT
  case $source in
    audio) tool=pactl ;;
    brightness) tool='light udevadm' ;;
    battery) tool=upower ;;
    wifi) tool=nmcli ;;
    bluetooth) tool='gdbus bluetoothctl' ;;
    screenshot) tool=inotifywait ;;
  esac
  for path in $tool; do
    if ! require "$path"; then
      printf 'alert: sumber %s dilewati, %s tidak tersedia\n' "$source" "$path" >&2
      return 0
    fi
  done
  case $source in
    audio)
      run_forever monitor_stream audio_event pactl subscribe ;;
    brightness)
      run_forever monitor_stream brightness_event udevadm monitor --udev --subsystem-match=backlight ;;
    battery)
      path=$(upower -e)
      while IFS= read -r battery_path; do [[ $battery_path == *battery_* ]] && break; done <<< "$path"
      [[ $battery_path == *battery_* ]] || return 0
      run_forever monitor_stream battery_event upower --monitor ;;
    wifi)
      run_forever monitor_stream wifi_event nmcli monitor ;;
    bluetooth)
      run_forever monitor_stream bluetooth_event gdbus monitor --system --dest org.bluez ;;
    screenshot)
      path=$(screenshot_dir)
      if ! mkdir -p "$path"; then
        printf 'alert: sumber screenshot dilewati, %s tidak dapat dibuat\n' "$path" >&2
        return 0
      fi
      run_forever monitor_stream screenshot_event inotifywait -m -q -e close_write,moved_to --format '%w%f' "$path" ;;
    temperature)
      if ! temperature_find; then
        printf 'alert: sumber temperature dilewati, sensor suhu tidak ditemukan\n' >&2
        return 0
      fi
      while true; do
        temperature_snapshot
        poll_sleep "${ISLAND_TEMP_INTERVAL:-5}"
      done ;;
  esac
}

seconds_us() {
  local whole=${1%%.*} fraction=''
  [[ $1 != *.* ]] || fraction=${1#*.}
  fraction=${fraction}000000
  printf '%s' "$((10#$whole * 1000000 + 10#${fraction:0:6}))"
}

listener_cleanup() {
  local pid
  for pid in "${worker_pids[@]}"; do kill "$pid" 2>/dev/null || :; done
  for pid in "${worker_pids[@]}"; do wait "$pid" 2>/dev/null || :; done
  rm -rf -- "$workdir"
}

main() {
  require jq || { printf 'alert: jq tidak tersedia\n' >&2; return 127; }
  local state="${XDG_RUNTIME_DIR:-/tmp}/eww-island" workdir source input_fd
  local line current='' last=$CLEAR_JSON deadline=0 now remaining timeout kind hold
  local hud_us alert_us
  local -a worker_pids=()
  hud_us=$(seconds_us "${ISLAND_HUD_SECONDS:-1.5}")
  alert_us=$(seconds_us "${ISLAND_ALERT_SECONDS:-3}")
  mkdir -p "$state"
  workdir=$(mktemp -d "$state/alert.XXXXXX") || return
  trap 'exit 0' TERM INT HUP
  trap listener_cleanup EXIT
  mkfifo "$workdir/events"
  exec {input_fd}<> "$workdir/events"
  printf '%s\n' "$CLEAR_JSON"
  for source in audio brightness battery wifi bluetooth screenshot temperature; do
    source_worker "$source" > "$workdir/events" &
    worker_pids+=("$!")
  done
  while true; do
    if (( deadline )); then
      now=${EPOCHREALTIME/./}
      remaining=$((deadline - now))
      if (( remaining <= 0 )); then
        if [[ $last != "$CLEAR_JSON" ]]; then printf '%s\n' "$CLEAR_JSON"; fi
        last=$CLEAR_JSON current='' deadline=0
        continue
      fi
      printf -v timeout '%d.%06d' "$((remaining / 1000000))" "$((remaining % 1000000))"
      IFS= read -r -t "$timeout" -u "$input_fd" line || continue
    else
      IFS= read -r -u "$input_fd" line || continue
    fi
    if [[ $line == '@refresh '* ]]; then
      kind=${line#@refresh }
      [[ $current == "$kind" ]] || continue
    else
      [[ $line =~ \"kind\":\"([^\"]+)\" ]] || continue
      kind=${BASH_REMATCH[1]}
      current=$kind
      if [[ $line != "$last" ]]; then printf '%s\n' "$line"; last=$line; fi
    fi
    case $kind in
      volume|mic|brightness) hold=$hud_us ;;
      *) hold=$alert_us ;;
    esac
    now=${EPOCHREALTIME/./}
    deadline=$((now + hold))
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
