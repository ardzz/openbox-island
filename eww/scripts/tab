#!/usr/bin/env bash
# tab resolve [TAB] | select TAB | next | prev | up | down
# Tabs of the expanded island card. The shown tab is the eww variable island_tab; the last
# tab the user picked is saved in $ISLAND_STATE/tab. A tab is offered only while it has content.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# Scroll gestures arrive as bursts of events: one switch per this many deciseconds.
DEBOUNCE_DS=5

# Header order = lib/tabs/NN-<id>.sh in numeric order; each defines tab_<id>_available.
# A new tab: add its file there, then its chip and page in yuck/island.yuck.
TABS=()
for f in "$DIR"/lib/tabs/*.sh; do
  # shellcheck source=/dev/null
  source "$f"
  f=${f##*/}; f=${f%.sh}; TABS+=("${f#*-}")
done
unset f

known() { local t; for t in "${TABS[@]}"; do [[ $t == "$1" ]] && return 0; done; return 1; }

# available: available tabs in header order, one per line.
available() { local t; for t in "${TABS[@]}"; do "tab_${t}_available" && printf '%s\n' "$t"; done; }

# resolve [TAB]: TAB if available, else the saved tab if available, else the first available
# tab, else the first tab. Never saves.
resolve() {
  local t saved list
  saved=$(cat "$ISLAND_STATE/tab" 2>/dev/null)
  list=$(available)
  for t in "${1:-}" "$saved" "${list%%$'\n'*}"; do
    if [[ -n $t ]] && grep -qxF -- "$t" <<< "$list"; then printf '%s\n' "$t"; return 0; fi
  done
  printf '%s\n' "${TABS[0]}"
}

select_tab() {
  mkdir -p "$ISLAND_STATE"
  printf '%s\n' "$1" > "$ISLAND_STATE/tab"
  island_eww update "island_tab=$1"
  # The notification center marks its list read while its tab is shown.
  notif_signal "@tab $1"
}

# step +1|-1: move the shown tab over the available tabs, wrapping around.
step() {
  local fd now last list=() current i
  mkdir -p "$ISLAND_STATE"
  exec {fd}>"$ISLAND_STATE/tab.lock"
  flock "$fd" || return
  now=$(date +%s%1N)
  last=$(cat "$ISLAND_STATE/tab_at" 2>/dev/null)
  [[ $last =~ ^[0-9]+$ ]] || last=0
  (( now - 10#$last >= DEBOUNCE_DS )) || return 0
  mapfile -t list < <(available)
  (( ${#list[@]} >= 2 )) || return 0
  current=$(island_eww get island_tab 2>/dev/null)
  for i in "${!list[@]}"; do [[ ${list[i]} == "$current" ]] && break; done
  [[ ${list[i]} == "$current" ]] || i=$(( $1 > 0 ? -1 : 0 ))
  printf '%s\n' "$now" > "$ISLAND_STATE/tab_at"
  select_tab "${list[(i + $1 + ${#list[@]}) % ${#list[@]}]}"
}

usage() { echo "usage: tab resolve [TAB] | select TAB | next | prev | up | down" >&2; return 2; }

main() {
  case ${1:-} in
    resolve) resolve "${2:-}" ;;
    select) known "${2:-}" || { usage; return; }; select_tab "$2" ;;
    next|down) step 1 ;;
    prev|up) step -1 ;;
    *) usage ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
