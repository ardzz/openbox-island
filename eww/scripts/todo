#!/usr/bin/env bash
# todo: deflisten printing the to-do list (expanded card tab "tugas"), one JSON object per line.
# todo add TEXT [--due EPOCH] | set-due ID EPOCH|none | prompt | due ID | toggle ID | remove ID | clear-done | scroll up|down
# The list lives in $XDG_DATA_HOME/eww-island/todo.json so it survives reboots. Commands change it
# through lib/store.sh and send "@refresh" to the FIFO
# $ISLAND_STATE/todo.fifo; the listener also takes "@scroll -1|1" and "@expanded 0".
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/store.sh
source "$DIR/lib/store.sh"
# shellcheck source=lib/todo/data.sh
source "$DIR/lib/todo/data.sh"
# shellcheck source=lib/todo/deadline.sh
source "$DIR/lib/todo/deadline.sh"
# shellcheck source=lib/listener.sh
source "$DIR/lib/listener.sh"
# shellcheck source=lib/paged.sh
source "$DIR/lib/paged.sh"
# shellcheck source=lib/todo/render.sh
source "$DIR/lib/todo/render.sh"
ROWS=4
MAX_TEXT=200

# Raw text -> one trimmed line of at most $max characters.
TEXT_JQ='$t | gsub("[[:cntrl:][:space:]]+"; " ") | ltrimstr(" ") | .[:$max] | rtrimstr(" ")'
ADD_JQ='.next_id as $id
  | .items += [{id: $id, text: $text, done: false, created: $now}
      + (if $due == null then {} else {due: $due, reminded: $reminded} end)]
  | .next_id = $id + 1'
SET_DUE_JQ='if any(.items[]; .id == $id)
  then .items |= map(if .id != $id then .
    elif $due == null then del(.due, .reminded) else .due = $due | .reminded = $reminded end)
  else null end'
# Toggle and remove answer null for an unknown id: nothing is saved.
TOGGLE_JQ='if any(.items[]; .id == $id)
  then .items |= map(if .id == $id then (.done |= not) | .done_at = (if .done then $now else null end) else . end)
  else null end'
REMOVE_JQ='if any(.items[]; .id == $id) then .items |= map(select(.id != $id)) else null end'
CLEAR_JQ='.items |= map(select(.done | not))'


now_us() { printf '%s' "${EPOCHREALTIME/./}"; }

# due_args EPOCH|none: the jq arguments setting that deadline, its past reminders marked fired.
due_args() {
  if [[ $1 == none ]]; then printf '%s\0' --argjson due null --argjson reminded null; return; fi
  printf '%s\0' --argjson due "$((10#$1))" --argjson reminded "$(deadline_passed_keys "$((10#$1))" "$(todo_now)")"
}

add() {
  local text
  local -a due
  text=$(jq -rn --arg t "$1" --argjson max "$MAX_TEXT" "$TEXT_JQ") || return
  if [[ -z $text ]]; then printf 'todo: teks kosong\n' >&2; return 1; fi
  mapfile -d '' -t due < <(due_args "${2:-none}")
  todo_change "$ADD_JQ" --arg text "$text" --argjson now "$(now_us)" "${due[@]}"
}

set_due() {
  local -a due
  mapfile -d '' -t due < <(due_args "$2")
  todo_change "$SET_DUE_JQ" --argjson id "$((10#$1))" "${due[@]}"
}

# ask_due FIRST: a deadline picked in rofi after FIRST: an epoch, "none" for FIRST, or "" when cancelled.
# An unreadable answer is reported and fails.
ask_due() {
  local choice epoch
  choice=$(printf '%s\n' "$1" "${DEADLINE_PRESETS[@]}" | rofi -dmenu -i -p Deadline) || return 0
  [[ -n ${choice//[[:space:]]/} ]] || return 0
  if [[ $choice == "$1" ]]; then printf 'none\n'; return 0; fi
  if epoch=$(deadline_parse "$choice" "$(todo_now)"); then printf '%s\n' "$epoch"; return 0; fi
  if require notify-send; then notify-send -a Tugas -- 'Deadline tidak dikenali' "$choice"; fi
  printf 'todo: deadline tidak dikenali: %s\n' "$choice" >&2
  return 1
}

# prompt: close the card (it cannot take keyboard focus), ask rofi for the text, then its deadline.
prompt() {
  require rofi || { printf 'todo: rofi tidak tersedia\n' >&2; return 127; }
  local text due
  "$DIR/island" dismiss
  text=$(rofi -dmenu -p Tugas -l 0 < /dev/null) || return 0
  [[ -n ${text//[[:space:]]/} ]] || return 0
  due=$(ask_due 'Tanpa deadline') || due=''
  add "$text" "${due:-none}"
}

# due_prompt ID: close the card and set, change or clear ID's deadline from rofi.
due_prompt() {
  require rofi || { printf 'todo: rofi tidak tersedia\n' >&2; return 127; }
  local id=$((10#$1)) due
  jq -e --argjson id "$id" 'any(.items[]; .id == $id)' <<< "$(store_read "$TODO_FILE" "$TODO_EMPTY")" > /dev/null || return 1
  "$DIR/island" dismiss
  due=$(ask_due 'Hapus deadline') || return 1
  [[ -z $due ]] || set_due "$id" "$due"
}

# load: read the list (missing or corrupt = empty) and keep the offset within it.
load() {
  doc=$(store_read "$TODO_FILE" "$TODO_EMPTY")
  read -r total timed < <(jq -r '[(.items | length),
    (if any(.items[]; (.done | not) and .due != null) then 1 else 0 end)] | @tsv' <<< "$doc")
  (( offset <= total - ROWS )) || offset=$(( total > ROWS ? total - ROWS : 0 ))
}

# scroll STEP: move the shown rows by STEP within the list.
scroll() {
  local top=$(( total > ROWS ? total - ROWS : 0 ))
  offset=$((offset + $1))
  (( offset >= 0 )) || offset=0
  (( offset <= top )) || offset=$top
}

todo_render() {
  [[ -n $doc ]] || return 1
  jq -c --argjson offset "$offset" --argjson rows "$ROWS" --argjson now "$(todo_now)" "$TODO_RENDER_JQ" <<< "$doc" 2>/dev/null
}

todo_handle() {
  case $1 in
    '@refresh'|'@tick') load ;;
    '@scroll -1') scroll -1 ;;
    '@scroll 1') scroll 1 ;;
    '@expanded 0') offset=0 ;;
  esac
  listen_tick=0; if (( timed )); then listen_tick=${ISLAND_TODO_TICK:-60}; fi
}

usage() { printf 'usage: todo [add TEXT [--due EPOCH] | set-due ID EPOCH|none | prompt | due ID | toggle ID | remove ID | clear-done | scroll up|down]\n' >&2; return 2; }

main() {
  case ${1:-} in
    scroll)
      case ${2:-} in
        up) fifo_signal todo '@scroll -1' ;;
        down) fifo_signal todo '@scroll 1' ;;
        *) usage; return ;;
      esac
      return 0 ;;
    add|set-due|prompt|due|toggle|remove|clear-done|'') ;;
    *) usage; return ;;
  esac
  require jq || { printf 'todo: jq tidak tersedia\n' >&2; return 127; }
  case ${1:-} in
    add)
      if (( $# == 2 )); then add "$2"
      elif (( $# == 4 )) && [[ $3 == --due && $4 =~ ^[0-9]{1,12}$ ]]; then add "$2" "$4"
      else usage; return; fi ;;
    set-due)
      (( $# == 3 )) && [[ $2 =~ ^[0-9]{1,15}$ && ( $3 == none || $3 =~ ^[0-9]{1,12}$ ) ]] || { usage; return; }
      set_due "$2" "$3" ;;
    prompt) prompt ;;
    due) (( $# == 2 )) && [[ $2 =~ ^[0-9]{1,15}$ ]] || { usage; return; }; due_prompt "$2" ;;
    toggle|remove)
      [[ ${2:-} =~ ^[0-9]{1,15}$ ]] || { usage; return; }
      if [[ $1 == toggle ]]; then
        todo_change "$TOGGLE_JQ" --argjson id "$((10#$2))" --argjson now "$(now_us)"
      else
        todo_change "$REMOVE_JQ" --argjson id "$((10#$2))"
      fi ;;
    clear-done) todo_change "$CLEAR_JQ" ;;
    '')
      local doc='' total=0 timed=0 offset=0
      # The first load comes as a "@tick" right after the FIFO exists, so it misses no "@refresh".
      # shellcheck disable=SC2034 # read by listen
      listen_tick=0.000001
      # Each line renders at once: commands and scrolls show without a settle delay.
      LISTEN_SETTLE=0 listen todo todo_render todo_handle ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
