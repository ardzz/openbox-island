#!/usr/bin/env bash
# todo: deflisten printing the to-do list (expanded card tab "tugas"), one JSON object per line.
# todo add TEXT | prompt | toggle ID | remove ID | clear-done | scroll up|down
# The list lives in $XDG_DATA_HOME/eww-island/todo.json so it survives reboots. Commands change it
# through lib/store.sh and send "@refresh" to the FIFO
# $ISLAND_STATE/todo.fifo; the listener also takes "@scroll -1|1" and "@expanded 0".
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/store.sh
source "$DIR/lib/store.sh"
# shellcheck source=lib/listener.sh
source "$DIR/lib/listener.sh"
# shellcheck source=lib/paged.sh
source "$DIR/lib/paged.sh"
FILE="${XDG_DATA_HOME:-$HOME/.local/share}/eww-island/todo.json"
ROWS=4
MAX_TEXT=200
EMPTY='{"next_id":1,"items":[]}'

# A stored list failing this is corrupt: it reads as empty and is kept aside on the next change.
# shellcheck disable=SC2034 # read by lib/store.sh
STORE_VALID_JQ='type == "object" and (.items | type) == "array"
  and all(.items[]; type == "object" and (.id | type) == "number" and (.text | type) == "string"
    and (.done | type) == "boolean")'
# A stored list -> the list with next_id past every id.
NORMALIZE_JQ='{next_id: ([(.next_id | numbers) // 0, ((.items | map(.id) | max) // 0) + 1] | max), items}'
# Raw text -> one trimmed line of at most $max characters.
TEXT_JQ='$t | gsub("[[:cntrl:][:space:]]+"; " ") | ltrimstr(" ") | .[:$max] | rtrimstr(" ")'
ADD_JQ='.next_id as $id | .items += [{id: $id, text: $text, done: false, created: $now}] | .next_id = $id + 1'
# Toggle and remove answer null for an unknown id: nothing is saved.
TOGGLE_JQ='if any(.items[]; .id == $id)
  then .items |= map(if .id == $id then (.done |= not) | .done_at = (if .done then $now else null end) else . end)
  else null end'
REMOVE_JQ='if any(.items[]; .id == $id) then .items |= map(select(.id != $id)) else null end'
CLEAR_JQ='.items |= map(select(.done | not))'
# Open items newest first, then done items latest finished first.
RENDER_JQ='(.items | map(select(.done | not)) | sort_by(-.id)) as $open
  | (.items | map(select(.done)) | sort_by(-(.done_at // 0), -.id)) as $done
  | ($open + $done) as $all | ($all | length) as $total | ($open | length) as $count
  | ($all | '"$PAGED_JQ"') as $page
  | {open: $count, done: ($done | length), total: $total,
     label: ("Tugas" + (if $count > 0 then " \($count)" else "" end)),
     rows: [$page.rows[] | {id, text, done}], more: $page.more, offset: $page.offset}'

# change FILTER [JQ ARGS...]: apply FILTER to the list and tell the listener.
# Status 1 when FILTER answers null (nothing saved), 3 on other failures.
change() {
  local rc=0
  store_update "$FILE" "$EMPTY" "$NORMALIZE_JQ | ($1)" "${@:2}" || rc=$?
  if (( rc == 0 )); then fifo_signal todo '@refresh'; return 0; fi
  return $(( rc == 1 ? 1 : 3 ))
}

now_us() { printf '%s' "${EPOCHREALTIME/./}"; }

add() {
  local text
  text=$(jq -rn --arg t "$1" --argjson max "$MAX_TEXT" "$TEXT_JQ") || return
  if [[ -z $text ]]; then printf 'todo: teks kosong\n' >&2; return 1; fi
  change "$ADD_JQ" --arg text "$text" --argjson now "$(now_us)"
}

# prompt: close the card (it cannot take keyboard focus), ask rofi and add the answer.
prompt() {
  require rofi || { printf 'todo: rofi tidak tersedia\n' >&2; return 127; }
  local text
  "$DIR/island" dismiss
  text=$(rofi -dmenu -p Tugas -l 0 < /dev/null) || return 0
  [[ -z ${text//[[:space:]]/} ]] || add "$text"
}

# load: read the list (missing or corrupt = empty) and keep the offset within it.
load() {
  doc=$(store_read "$FILE" "$EMPTY")
  total=$(jq '.items | length' <<< "$doc")
  (( offset <= total - ROWS )) || offset=$(( total > ROWS ? total - ROWS : 0 ))
}

# scroll STEP: move the shown rows by STEP within the list.
scroll() {
  local top=$(( total > ROWS ? total - ROWS : 0 ))
  offset=$((offset + $1))
  (( offset >= 0 )) || offset=0
  (( offset <= top )) || offset=$top
}

todo_render() {
  [[ -n $doc ]] || return 1
  jq -c --argjson offset "$offset" --argjson rows "$ROWS" "$RENDER_JQ" <<< "$doc" 2>/dev/null
}

todo_handle() {
  case $1 in
    '@refresh'|'@tick') load ;;
    '@scroll -1') scroll -1 ;;
    '@scroll 1') scroll 1 ;;
    '@expanded 0') offset=0 ;;
  esac
  listen_tick=0
}

usage() { printf 'usage: todo [add TEXT | prompt | toggle ID | remove ID | clear-done | scroll up|down]\n' >&2; return 2; }

main() {
  case ${1:-} in
    scroll)
      case ${2:-} in
        up) fifo_signal todo '@scroll -1' ;;
        down) fifo_signal todo '@scroll 1' ;;
        *) usage; return ;;
      esac
      return 0 ;;
    add|prompt|toggle|remove|clear-done|'') ;;
    *) usage; return ;;
  esac
  require jq || { printf 'todo: jq tidak tersedia\n' >&2; return 127; }
  case ${1:-} in
    add) (( $# == 2 )) || { usage; return; }; add "$2" ;;
    prompt) prompt ;;
    toggle|remove)
      [[ ${2:-} =~ ^[0-9]{1,15}$ ]] || { usage; return; }
      if [[ $1 == toggle ]]; then
        change "$TOGGLE_JQ" --argjson id "$((10#$2))" --argjson now "$(now_us)"
      else
        change "$REMOVE_JQ" --argjson id "$((10#$2))"
      fi ;;
    clear-done) change "$CLEAR_JQ" ;;
    '')
      local doc='' total=0 offset=0
      # The first load comes as a "@tick" right after the FIFO exists, so it misses no "@refresh".
      # shellcheck disable=SC2034 # read by listen
      listen_tick=0.000001
      # Each line renders at once: commands and scrolls show without a settle delay.
      LISTEN_SETTLE=0 listen todo todo_render todo_handle ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
