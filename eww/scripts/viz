#!/usr/bin/env bash
# viz: six audio-reactive levels from the active MPRIS owner's playback stream.
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"

viz_frame() {
  [[ $1 =~ ^((1[0-2]|[0-9])\;){6}$ ]] || return 1
  VIZ_FRAME=${1%;}
  VIZ_FRAME="[${VIZ_FRAME//;/,}]"
}

viz_frames() {
  local line VIZ_FRAME
  while IFS= read -r line; do
    if viz_frame "$line"; then printf '%s\n' "$VIZ_FRAME"; fi
  done
  return 0
}

# Integer fps: valid ISLAND_VIZ_FPS, else the current refresh rate of the output at the
# screen origin (or the primary), clamped to 1..240; 60 when that cannot be read.
viz_fps() {
  local fps=${ISLAND_VIZ_FPS-} line xrandr hz on_origin=0 on_primary=0 origin='' primary=''
  if [[ $fps =~ ^[1-9][0-9]{0,2}$ ]] && (( fps <= 240 )); then
    printf '%s\n' "$fps"
    return 0
  fi
  fps=60
  if [[ -n ${DISPLAY-} ]] && command -v xrandr >/dev/null 2>&1; then
    xrandr=$(xrandr --current 2>/dev/null) || xrandr=''
    while IFS= read -r line; do
      if [[ $line != [[:space:]]* ]]; then
        on_origin=0 on_primary=0
        [[ $line =~ ^[^[:space:]]+\ connected(\ primary)?\ [0-9]+x[0-9]+\+([0-9]+)\+([0-9]+) ]] || continue
        [[ -z ${BASH_REMATCH[1]} ]] || on_primary=1
        (( 10#${BASH_REMATCH[2]} || 10#${BASH_REMATCH[3]} )) || on_origin=1
      elif (( on_origin || on_primary )) && [[ $line =~ [[:space:]]([0-9]+)(\.([0-9]*))?\* ]]; then
        hz=$(( 10#${BASH_REMATCH[1]} ))
        [[ ${BASH_REMATCH[3]:0:1} != [5-9] ]] || hz=$((hz + 1))
        if (( on_origin )) && [[ -z $origin ]]; then origin=$hz; fi
        if (( on_primary )) && [[ -z $primary ]]; then primary=$hz; fi
      fi
    done <<< "$xrandr"
    hz=${origin:-$primary}
    if [[ -n $hz ]]; then
      fps=$(( hz < 1 ? 1 : hz > 240 ? 240 : hz ))
    fi
  fi
  printf '%s\n' "$fps"
}

# CAVA's integral filter keeps mem*nr/(66/fps)^0.1 of the previous frame, a settle time
# tau = 1/(fps*(1 - nr/(66/fps)^0.1)). Solve for nr so tau stays that of 90 at 60 fps:
# nr = 100*(1 - 1/(tau*fps))*(66/fps)^0.1, clamped to 0..100.
viz_cava_config() {
  awk -v fps="$1" '
    BEGIN {
      tau = 1 / (60 * (1 - 0.90 * (60 / 66) ^ 0.1))
      nr = 100 * (1 - 1 / (tau * fps)) * (66 / fps) ^ 0.1
      nr = nr < 0 ? 0 : nr > 100 ? 100 : nr
    }
    /^framerate = / { print "framerate = " fps; next }
    /^noise_reduction = / { printf "noise_reduction = %.0f\n", nr; next }
    { print }' "$DIR/../cava.conf"
}

viz_descendant() {
  local child=$1 owner=$2 key value parent
  local -A seen=()
  [[ $child =~ ^[1-9][0-9]*$ && $owner =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r /proc/$owner/status ]] || return 1
  while [[ -r /proc/$child/status && ! ${seen[$child]+present} ]]; do
    [[ $child == "$owner" ]] && return 0
    seen[$child]=1
    parent=''
    while read -r key value _; do
      if [[ $key == PPid: ]]; then parent=$value; break; fi
    done < "/proc/$child/status"
    [[ $parent =~ ^[1-9][0-9]*$ ]] || return 1
    child=$parent
  done
  return 1
}

# Streams from in-process players (libmpv) may lack application.process.id;
# their client's pid then decides, preferring the socket-derived
# pipewire.sec.pid over the client-supplied application.process.id.
viz_client_pids() {
  pactl -f json list clients 2>/dev/null | jq -r '.[] | .properties as $p |
    [(.index | tostring),
     ([$p["pipewire.sec.pid"], $p["application.process.id"]] |
      map(select(. != null) | tostring | select(test("^[1-9][0-9]*$"))) | .[0] // "")] |
    join("|")' 2>/dev/null
}

viz_select() {
  local owner=$1 rows pid serial rank client best='' best_rank=-1 pid_re='^[1-9][0-9]*$'
  local -A client_pid=()
  rows=$(jq -r '.[] | select(.corked == true or .corked == false) |
    [(.properties["application.process.id"] // ""),
     (.properties["object.serial"] // ""), (if .corked then 0 else 1 end), (.client // "")] |
    map(tostring) | join("|")') || return 0
  while IFS='|' read -r pid _ _ client; do
    [[ ! $pid =~ $pid_re && $client =~ ^[0-9]+$ ]] || continue
    while IFS='|' read -r client pid; do
      [[ $client =~ ^[0-9]+$ ]] && client_pid[$client]=$pid
    done < <(viz_client_pids)
    break
  done <<< "$rows"
  while IFS='|' read -r pid serial rank client; do
    if [[ ! $pid =~ $pid_re && $client =~ ^[0-9]+$ ]]; then pid=${client_pid[$client]-}; fi
    [[ $pid =~ $pid_re && $serial =~ ^[1-9][0-9]*$ && $rank =~ ^[01]$ ]] || continue
    viz_descendant "$pid" "$owner" || continue
    if (( rank > best_rank )) || { (( rank == best_rank )) && [[ $serial -gt ${best:-0} ]]; }; then
      best=$serial
      best_rank=$rank
    fi
  done <<< "$rows"
  [[ -z $best ]] || printf '%s\n' "$best"
  return 0
}

viz_target() {
  local instance=$1 reply owner streams
  [[ -n $instance ]] || return 0
  reply=$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetConnectionUnixProcessID s "org.mpris.MediaPlayer2.$instance" 2>/dev/null) || return 0
  [[ $reply =~ ^u\ ([1-9][0-9]*)$ ]] || return 0
  owner=${BASH_REMATCH[1]}
  streams=$(pactl -f json list sink-inputs 2>/dev/null) || return 0
  viz_select "$owner" <<< "$streams"
}

# These lifecycle helpers run only in the owning supervisor shell.
viz_emit() {
  [[ $1 == "$last" ]] && return 0
  printf '%s\n' "$1"
  last=$1
}

viz_terminate() {
  local pid alive=0
  for pid in "$@"; do
    [[ -z $pid ]] || kill -TERM "$pid" 2>/dev/null || :
  done
  for pid in "$@"; do
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then alive=1; fi
  done
  # One shared grace period per batch, not one delay per child.
  (( ! alive )) || sleep 0.5
  for pid in "$@"; do
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || :
    fi
  done
  for pid in "$@"; do
    [[ -z $pid ]] || wait "$pid" 2>/dev/null || :
  done
}

viz_stop_capture() {
  viz_terminate "$recorder" "$analyzer"
  recorder='' analyzer='' current=''
  # No writers remain: discard old-target frames before allowing another capture.
  while IFS= read -r -t 0.01 -u "$frames" line; do :; done
  viz_emit '[0,0,0,0,0,0]'
}

viz_cleanup() {
  trap - EXIT TERM INT
  viz_stop_capture
  viz_terminate "$pulse_watch" "$state_watch"
  exec {frames}>&- {events}>&-
  rm -rf -- "$work"
}

main() {
  local last='' VIZ_FRAME line instance target current=''
  local recorder='' analyzer='' pulse_watch='' state_watch=''
  local work frames events deadline=0 retry_at=0 last_frame=$SECONDS dirty=1 count
  viz_emit '[0,0,0,0,0,0]'
  if ! require busctl pactl pw-record cava inotifywait jq mktemp mkfifo awk; then
    printf 'viz: missing dependency %s\n' "$MISSING_DEP" >&2
    return 0
  fi
  mkdir -p "$ISLAND_STATE" || return 0
  work=$(mktemp -d "$ISLAND_STATE/viz.XXXXXXXX") || return 0
  if ! mkfifo "$work/events" "$work/frames" "$work/pcm"; then
    rm -rf -- "$work"
    return 0
  fi
  exec {events}<>"$work/events" {frames}<>"$work/frames"
  trap 'exit 0' TERM INT
  trap viz_cleanup EXIT
  while true; do
    if (( SECONDS >= deadline )); then
      dirty=1
      deadline=$((SECONDS + 2))
      if [[ -z $pulse_watch ]] || ! kill -0 "$pulse_watch" 2>/dev/null; then
        [[ -z $pulse_watch ]] || wait "$pulse_watch" 2>/dev/null || :
        pactl subscribe > "$work/events" 2>/dev/null &
        pulse_watch=$!
      fi
      if [[ -z $state_watch ]] || ! kill -0 "$state_watch" 2>/dev/null; then
        [[ -z $state_watch ]] || wait "$state_watch" 2>/dev/null || :
        inotifywait -m -q -e close_write --format 'state:%f' "$ISLAND_STATE" > "$work/events" 2>/dev/null &
        state_watch=$!
      fi
    fi
    if [[ -n $current ]] && { ! kill -0 "$recorder" 2>/dev/null || ! kill -0 "$analyzer" 2>/dev/null; }; then
      printf 'viz: audio worker exited; clearing levels\n' >&2
      viz_stop_capture
      retry_at=$((SECONDS + 2))
      dirty=1
    fi
    if (( dirty )); then
      dirty=0
      instance=''
      [[ ! -r $ISLAND_STATE/player ]] || IFS= read -r instance < "$ISLAND_STATE/player" || :
      target=$(viz_target "$instance")
      if [[ $target != "$current" ]]; then
        viz_stop_capture
        if [[ -n $target ]] && (( SECONDS >= retry_at )); then
          if viz_cava_config "$(viz_fps)" > "$work/cava.conf"; then
            cava -p "$work/cava.conf" < "$work/pcm" > "$work/frames" &
            analyzer=$!
            pw-record --raw --target "$target" --format s16 --rate 48000 --channels 2 \
              --properties='{"node.dont-fallback":true,"application.name":"eww-island-viz"}' - > "$work/pcm" &
            recorder=$!
            current=$target
            last_frame=$SECONDS
          else
            printf 'viz: cannot render cava config; retrying\n' >&2
            retry_at=$((SECONDS + 2))
          fi
        fi
      fi
    fi
    if [[ -n $current ]]; then
      if IFS= read -r -t 0.1 -u "$frames" line && viz_frame "$line"; then
        viz_emit "$VIZ_FRAME"
        last_frame=$SECONDS
      elif (( SECONDS - last_frame >= 2 )); then
        viz_emit '[0,0,0,0,0,0]'
      fi
    else
      if IFS= read -r -t 1 -u "$events" line; then
        case $line in
          state:player|*"'new' on sink-input"*|*"'remove' on sink-input"*) dirty=1 ;;
        esac
      fi
    fi
    # Bound event draining so a busy Pulse server cannot starve frame/deadline work.
    for ((count=0; count<64; count++)); do
      IFS= read -r -t 0.001 -u "$events" line || break
      case $line in
        state:player|*"'new' on sink-input"*|*"'remove' on sink-input"*) dirty=1 ;;
      esac
    done
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
