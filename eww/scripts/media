#!/usr/bin/env bash
# media: now-playing JSON for the island from the highest-priority MPRIS player (playerctl).
# shellcheck source-path=SCRIPTDIR
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/core.sh
source "$DIR/lib/core.sh"
# shellcheck source=lib/media/art.sh
source "$DIR/lib/media/art.sh"
# shellcheck source=lib/media/color.sh
source "$DIR/lib/media/color.sh"
# shellcheck source=lib/media/record.sh
source "$DIR/lib/media/record.sh"
# shellcheck source=lib/media/transition.sh
source "$DIR/lib/media/transition.sh"
# shellcheck source=lib/media/gate.sh
source "$DIR/lib/media/gate.sh"

AUTO_SECONDS=4

# players_list: comma-separated priority list from eww/players.
players_list() {
  local list
  list=$(tr -d '[:space:]' 2>/dev/null < "${DIR%/scripts}/players")
  printf '%s\n' "${list:-ytm_player,ytermusic,edge}"
}

# publish JSON: hand JSON to eww and to the scripts that read media.json.
publish() {
  printf '%s\n' "$1" > "$ISLAND_STATE/media.json.tmp"
  mv "$ISLAND_STATE/media.json.tmp" "$ISLAND_STATE/media.json"
  printf '%s\n' "$1"
}

stream() {
  require playerctl jq || return 127
  local line rc key prev="" first=1 status player="" json grace deadline=0 left timeout settle
  local buf="" partial="" record pending="" shown="" GATE_LAST_MATCH_MS=0 GATE_DEADLINE_MS=0
  local wake gate_wake authorized candidate_wake recheck GATE_CANDIDATE=""
  recheck=${ISLAND_BRIDGE_RECHECK_MS:-250}
  [[ $recheck =~ ^[0-9]+$ ]] && (( recheck > 0 && recheck <= 1000 )) || recheck=250
  grace=$(grace_us)
  mkdir -p "$ISLAND_STATE"
  printf '\n' > "$ISLAND_STATE/player"
  publish "$NONE_JSON"
  while :; do
    settle=0 gate_wake=0 candidate_wake=0 wake=$deadline
    if (( GATE_DEADLINE_MS && (! wake || GATE_DEADLINE_MS * 1000 < wake) )); then
      wake=$(( GATE_DEADLINE_MS * 1000 )) gate_wake=1
    fi
    if [[ -n $GATE_CANDIDATE && -z $shown ]]; then
      left=$(( ${EPOCHREALTIME/./} + recheck * 1000 ))
      if (( ! wake || left < wake )); then wake=$left candidate_wake=1 gate_wake=0; fi
    fi
    if (( wake )); then
      left=$(( wake - ${EPOCHREALTIME/./} ))
      line="" rc=142
      if (( left > 0 )); then
        printf -v timeout '%d.%06d' $(( left / 1000000 )) $(( left % 1000000 ))
        IFS= read -r -t "$timeout" line; rc=$?
      fi
      # Timed-out reads retain partial input; gate expiry also wakes an otherwise silent player.
      if (( rc > 128 )); then
        partial+=$line
        if (( candidate_wake )); then
          record=$GATE_CANDIDATE
          gate_record record || continue
        elif (( gate_wake )); then
          record=$shown
          gate_record record || :
          if (( deadline )) && ! has_track "$pending"; then GATE_CANDIDATE=""; fi
          if (( deadline )) && [[ -n $record ]]; then continue; fi
        else
          record=$pending
        fi
        deadline=0 settle=1
      fi
    else
      IFS= read -r line; rc=$?
    fi
    if (( ! settle )); then
      (( rc == 0 )) || break
      line=$partial$line partial=""
      if [[ -z $buf && -z $line ]]; then
        record=""                    # playerctl prints an empty line when no player is left
      else
        buf+=${buf:+$'\n'}$line
        [[ $buf == *"$REC" ]] || continue
        record=${buf%"$REC"}
        buf=""
      fi
      authorized=1
      gate_record record || authorized=0
      if [[ -z $record && -z $line ]]; then
        case $player in
          edge|edge.*) gate_record shown || authorized=0 ;;
        esac
      fi
      [[ -n $buf$line ]] || GATE_CANDIDATE=""
      # A track change passes through records without a track: keep the shown player loading.
      if (( authorized )) && [[ -n $prev ]] && (( grace )) && ! has_track "$record"; then
        if (( ! deadline )); then
          deadline=$(( ${EPOCHREALTIME/./} + grace ))
          publish "$(loading_json "$player")"
        fi
        pending=$record
        continue
      fi
      deadline=0
    fi
    IFS=$SEP read -r status player _ <<<"$record"
    key=$(track_key "$record")
    [[ -n $key ]] || player=""
    if [[ -n $key ]]; then shown=$record; else shown="" GATE_DEADLINE_MS=0; fi
    json=$(media_json "$record")
    printf '%s\n' "$player" > "$ISLAND_STATE/player"
    if [[ -n $key && $key != "$prev" ]]; then date +%s%1N > "$ISLAND_STATE/marquee_at"; fi
    publish "$json"
    case $(media_action "$first" "$prev" "$key" "$status") in
      auto) "$DIR/island" auto "$AUTO_SECONDS" >/dev/null ;;
      close) "$DIR/island" close >/dev/null ;;
    esac
    prev=$key
    first=0
  done < <(playerctl --player="$(players_list)" --follow metadata --format "$FORMAT" 2>/dev/null)
}

main() { run_forever stream | emit_dedup; }

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
