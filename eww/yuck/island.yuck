; Between tracks (media.state "loading") the cover stays an empty grey block: a skeleton.
(defwidget cover [size]
  (box :class "cover cover-${size}" :valign "center"
       :style {media.art == "" ? "" : "background-image: url('${media.art}');"}
    (label :class "cover-fallback" :visible {media.art == "" && media.state != "loading"} :text "󰎈")))

; A grey placeholder for text that is still loading.
(defwidget skeleton [class width]
  (box :class "skeleton ${class}" :width width :hexpand false :halign "start" :valign "center"))

(defwidget equalizer []
  (box :class "eq" :orientation "h" :space-evenly false :spacing 3 :valign "center"
       :width 33 :height 16 :hexpand false
    (box :class "eqbar lvl${viz[0]}" :width 3 :hexpand false :valign "center")
    (box :class "eqbar lvl${viz[1]}" :width 3 :hexpand false :valign "center")
    (box :class "eqbar lvl${viz[2]}" :width 3 :hexpand false :valign "center")
    (box :class "eqbar lvl${viz[3]}" :width 3 :hexpand false :valign "center")
    (box :class "eqbar lvl${viz[4]}" :width 3 :hexpand false :valign "center")
    (box :class "eqbar lvl${viz[5]}" :width 3 :hexpand false :valign "center")))

(defwidget indicators []
  (box :orientation "h" :space-evenly false :spacing 0 :valign "center"
    (revealer :transition "none" :reveal {rec.active}
      (box :class "indicator" :width 56 :tooltip "Merekam layar: ${rec.app}"
        (box :orientation "h" :space-evenly false :spacing 4 :halign "end" :hexpand true
          (box :class "dot dot-rec" :valign "center")
          (label :class "rec-time" :text {rec.time}))))
    (revealer :transition "none" :reveal {status.mic}
      (box :class "indicator" :width 16 :tooltip "Mikrofon dipakai: ${status.mic_apps}"
        (box :class "dot dot-mic" :halign "end" :valign "center")))
    (revealer :transition "none" :reveal {status.camera}
      (box :class "indicator" :width 16 :tooltip "Kamera dipakai: ${status.camera_apps}"
        (box :class "dot dot-camera" :halign "end" :valign "center")))
    (revealer :transition "none" :reveal {status.dnd}
      (label :class "dnd" :width 16 :xalign 1
             :text "󰂛" :tooltip "Jangan Ganggu aktif"))))

(defwindow island
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "508px" :height "44px" :anchor "top center")
  :wm-ignore true
  ; Hovering a shown notification never expands the island: the pointer is on its way to click it.
  (eventbox :onhover {(media.state == "none" && !weather.ok && notif_center.total == 0) || (notify.active && alert.kind == "") ? "" : "${EWW_CONFIG_DIR}/scripts/island hover &"}
    ; The pill hangs from the top edge; the ears beside it curve into the screen edge like a notch.
    (box :halign "center" :valign "start" :visible {!island_reveal} :orientation "h" :space-evenly false
      (box :class "ear ear-left" :valign "start")
      (eventbox :onscroll "${EWW_CONFIG_DIR}/scripts/scroll {} &"
      (stack :selected {alert.kind != "" ? 2 : notify.active ? 3 : media.state == "none" ? 0 : 1} :transition "crossfade" :same-size false
        (box :class "pill pill-idle" :orientation "h" :halign "center" :space-evenly false :spacing 0
          (box :orientation "h" :halign "center" :hexpand true :space-evenly false :spacing 0
            (revealer :transition "none" :reveal {weather.ok}
              (box :orientation "h" :space-evenly false :spacing 6
                   :tooltip "${weather.desc}${weather.region != "" ? " · " + weather.region : ""}"
                (label :class "weather-icon tone-${weather.tone}" :text {weather.icon})
                (label :class "weather-temp" :text {weather.temp})
                (revealer :transition "none" :reveal {weather.city != ""}
                  (box :orientation "h" :space-evenly false :spacing 6
                    (label :class "weather-separator" :text "·")
                    (label :class "weather-city-small" :text {weather.city}
                           :limit-width 18 :show-truncated true)))))
            (indicators)))
        (box :class "pill pill-media ${media.state}" :orientation "h" :space-evenly false :spacing 10
          (cover :size "small")
          (box :orientation "v" :space-evenly false :spacing 0 :valign "center"
               :width {386 - 16 * ((status.mic ? 1 : 0) + (status.camera ? 1 : 0) + (status.dnd ? 1 : 0)) - (rec.active ? 56 : 0) - (status.headphone.kind != "none" ? 18 : 0)}
               :hexpand false
            (revealer :transition "none" :reveal {media.state != "loading"}
              (label :class "lyrics ${lyrics.synced ? 'synced' : 'fallback'}"
                     :text {lyrics.text} :tooltip {lyrics.text} :xalign 0.5 :justify "center"
                     :limit-width 49 :show-truncated true :wrap false))
            (revealer :transition "none" :reveal {media.state == "loading"}
              (box :halign "center" (skeleton :class "skeleton-lyrics" :width 200))))
          (box :orientation "h" :space-evenly false :spacing 0
            (equalizer)
            (revealer :transition "none" :reveal {status.headphone.kind != "none"}
              (label :class "headphone ${status.headphone.low ? 'headphone-low' : ''}" :width 18 :xalign 1
                     :text {status.headphone.icon} :tooltip {status.headphone.label}))
            (indicators)))
        (box :class "pill pill-alert alert-${alert.kind}" :orientation "h" :space-evenly false :spacing 10
          ; One slot for thumbnail or icon; revealers because :visible stays hidden in never-shown stack pages.
          (box :orientation "h" :space-evenly false :spacing 0 :valign "center"
            (revealer :transition "none" :reveal {alert.image != ""}
              (box :class "alert-thumb" :valign "center"
                   :style {alert.image == "" ? "" : "background-image: url('${alert.image}');"}))
            (revealer :transition "none" :reveal {alert.image == ""}
              (label :class "alert-icon" :width 24 :text {alert.icon})))
          (label :class "alert-text" :text {alert.text} :xalign 0 :hexpand true
                 :limit-width 28 :show-truncated true)
          (revealer :transition "none" :reveal {alert.level >= 0}
            (progress :class "hud" :width 140 :valign "center" :value {alert.level}))
          (revealer :transition "none" :reveal {alert.value != ""}
            (label :class "alert-value" :text {alert.value} :xalign 1 :limit-width 24
                   :show-truncated true)))
        (eventbox :onclick "${EWW_CONFIG_DIR}/scripts/notify click ${notify.id} &"
                  :tooltip "${notify.summary}${notify.body != "" ? " · " + notify.body : ""}"
          (box :class "pill pill-notify ${notify.critical ? 'notify-critical' : ''}" :orientation "h"
               :space-evenly false :spacing 10
            (box :orientation "h" :space-evenly false :spacing 0 :valign "center"
              (revealer :transition "none" :reveal {notify.image != ""}
                (box :class "notify-thumb" :valign "center"
                     :style {notify.image == "" ? "" : "background-image: url('${notify.image}');"}))
              (revealer :transition "none" :reveal {notify.image == ""}
                (label :class "notify-icon" :width 24 :text {notify.icon})))
            (box :orientation "v" :space-evenly false :spacing 1 :valign "center" :hexpand true
              (label :class "notify-summary" :text {notify.summary} :xalign 0
                     :limit-width 40 :show-truncated true :wrap false)
              (revealer :transition "none" :reveal {notify.body != ""}
                (label :class "notify-body" :text {notify.body} :xalign 0
                       :limit-width 50 :show-truncated true :wrap false)))
            (revealer :transition "none" :reveal {notify.app != ""}
              (label :class "notify-app" :text {notify.app} :xalign 1 :valign "center"
                     :limit-width 16 :show-truncated true))))))
      (box :class "ear ear-right" :valign "start"))))

; One header chip per tab (scripts/tab lists the order); revealed only while the tab has content.
(defwidget tab-chip [id label available]
  (revealer :transition "none" :reveal available
    (eventbox :cursor "pointer" :onclick "${EWW_CONFIG_DIR}/scripts/tab select ${id} &"
      (label :class "tab ${island_tab == id ? 'tab-active' : ''}" :text label))))

(defwindow island-expanded
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "508px" :height "218px" :anchor "top center")
  :wm-ignore true
  (eventbox :onhover "${EWW_CONFIG_DIR}/scripts/island hover &"
            :onhoverlost "${EWW_CONFIG_DIR}/scripts/island hover &"
    (box :halign "center" :valign "start"
      (revealer :transition "slidedown" :reveal island_reveal :duration "300ms"
       (box :orientation "h" :space-evenly false
        (box :class "ear ear-left" :valign "start")
        ; The header shows once two or more tabs have content (count each tab's condition).
        (box :class "pill pill-expanded ${(media.state != 'none' ? 1 : 0) + (weather.ok ? 1 : 0) + (notif_center.total > 0 ? 1 : 0) >= 2 ? 'with-tabs' : ''}"
             :orientation "v" :space-evenly false
          ; eww's onscroll only reports vertical scrolling: up/down over the header switches tabs.
          (revealer :transition "none" :reveal {(media.state != "none" ? 1 : 0) + (weather.ok ? 1 : 0) + (notif_center.total > 0 ? 1 : 0) >= 2}
            (eventbox :onscroll "${EWW_CONFIG_DIR}/scripts/tab {} &"
              (box :class "tabs" :orientation "h" :halign "center" :space-evenly false :spacing 4
                (tab-chip :id "musik" :label "Musik" :available {media.state != "none"})
                (tab-chip :id "cuaca" :label "Cuaca" :available {weather.ok})
                (tab-chip :id "notif" :label {notif_center.label} :available {notif_center.total > 0}))))
          (revealer :transition "none" :reveal {island_tab == "musik"}
        (box :class "page" :orientation "v" :space-evenly false :spacing 8
          (box :orientation "h" :space-evenly false :spacing 14
            (cover :size "large")
            (box :orientation "v" :space-evenly false :valign "center" :spacing 0
              (revealer :transition "none" :reveal {media.state != "loading"}
                (box :orientation "v" :space-evenly false :spacing 4
                  (label :class "title" :xalign 0 :limit-width 30 :show-truncated true :text {marquee.title})
                  (label :class "artist" :xalign 0 :limit-width 36 :show-truncated true :text {marquee.artist})))
              (revealer :transition "none" :reveal {media.state == "loading"}
                (box :orientation "v" :space-evenly false :spacing 4
                  (skeleton :class "skeleton-title" :width 180)
                  (skeleton :class "skeleton-artist" :width 120)))))
          ; Each row and its skeleton share one slot so the page keeps its spacing and height.
          (box :orientation "v" :space-evenly false :spacing 0
            (revealer :transition "none" :reveal {media.state != "loading"}
              (label :class "lyrics ${lyrics.synced ? 'synced' : 'fallback'}"
                     :text {lyrics.text} :tooltip {lyrics.text} :xalign 0.5 :justify "center"
                     :width 438 :hexpand false :limit-width 56 :show-truncated true :wrap false))
            (revealer :transition "none" :reveal {media.state == "loading"}
              (box :halign "center" (skeleton :class "skeleton-lyrics" :width 260))))
          (box :orientation "v" :space-evenly false :spacing 0
            (revealer :transition "none" :reveal {media.state != "loading"}
              (box :orientation "h" :space-evenly false :spacing 8
                (label :class "time" :text {pos.text})
                (progress :class "progress" :hexpand true :valign "center"
                          :value {media.length > 0 ? pos.pos * 100 / media.length : 0})
                (label :class "time" :text {media.length_text})))
            (revealer :transition "none" :reveal {media.state == "loading"}
              (box :class "skeleton-row" (skeleton :class "skeleton-progress" :width 438))))
          ; Up next and the headphone share one row so the card keeps its height; the device is centred when alone.
          (revealer :transition "none" :reveal {(ytm.active && ytm.next_title != "") || status.headphone.kind != "none"}
            (box :orientation "h" :space-evenly false :spacing 0 :width 438 :hexpand false
              (box :hexpand {ytm.active && ytm.next_title != ""}
                (revealer :transition "none" :reveal {ytm.active && ytm.next_title != ""}
                  (label :class "up-next" :xalign 0 :wrap false :show-truncated true
                         :limit-width {status.headphone.kind != "none" ? 40 : 62}
                         :text "Berikutnya: ${ytm.next_title} — ${ytm.next_artist}"
                         :tooltip "Berikutnya: ${ytm.next_title} — ${ytm.next_artist}")))
              (revealer :transition "none" :reveal {status.headphone.kind != "none"} :hexpand {!(ytm.active && ytm.next_title != "")}
                (box :class "device" :orientation "h" :space-evenly false :spacing 6 :tooltip {status.headphone.label}
                     :halign {ytm.active && ytm.next_title != "" ? "end" : "center"}
                  (label :class "device-icon ${status.headphone.low ? 'headphone-low' : ''}" :text {status.headphone.icon})
                  (label :class "device-name" :text {status.headphone.label} :limit-width 18 :show-truncated true)))))
          (box :class "controls" :orientation "h" :halign "center" :space-evenly false :spacing 28
            (revealer :transition "none" :reveal {ytm.active}
              (button :class "ctl ctl-ytm ${ytm.like == 'DISLIKE' ? 'on' : ''}" :tooltip "Tidak suka"
                      :onclick "${EWW_CONFIG_DIR}/scripts/ytm toggle-dislike &"
                {ytm.like == "DISLIKE" ? "󰔑" : "󰔒"}))
            (button :class "ctl" :onclick "playerctl --player=${media.player} previous &" "󰒮")
            (button :class "ctl ctl-main" :onclick "playerctl --player=${media.player} play-pause &"
              {media.state == "paused" ? "󰐊" : "󰏤"})
            (button :class "ctl" :onclick "playerctl --player=${media.player} next &" "󰒭")
            (revealer :transition "none" :reveal {ytm.active}
              (button :class "ctl ctl-ytm ${ytm.like == 'LIKE' ? 'on' : ''}" :tooltip "Suka"
                      :onclick "${EWW_CONFIG_DIR}/scripts/ytm toggle-like &"
                {ytm.like == "LIKE" ? "󰔓" : "󰔔"})))))
          (revealer :transition "none" :reveal {island_tab == "cuaca"}
        (box :class "page weather-card" :orientation "v" :space-evenly false :spacing 8
          (box :orientation "h" :space-evenly false :spacing 12
            (label :class "weather-big-icon tone-${weather.tone}" :text {weather.icon})
            (box :orientation "v" :space-evenly false :valign "center" :spacing 2
              (label :class "weather-big-temp" :text {weather.temp} :xalign 0)
              (label :class "weather-desc" :text {weather.desc} :xalign 0))
            (box :hexpand true)
            (box :orientation "v" :space-evenly false :halign "end" :valign "center" :spacing 2
              (label :class "weather-city" :text {weather.city} :xalign 1
                     :limit-width 24 :show-truncated true :tooltip "Lokasi: © kontributor OpenStreetMap")
              (label :class "weather-region" :text {weather.region} :xalign 1
                     :limit-width 28 :show-truncated true)
              (label :class "weather-sun" :xalign 1
                     :text "󰖜 ${weather.sunrise}   󰖛 ${weather.sunset}")))
          (label :class "weather-details" :xalign 0
                 :text "Terasa ${weather.feels} · Lembap ${weather.humidity} · Angin ${weather.wind} · UV ${weather.uv}")
          (box :orientation "h" :space-evenly true :spacing 8
            (for day in {weather.days}
              (box :orientation "v" :space-evenly false :halign "center" :spacing 2
                (label :class "forecast-day" :text {day.day})
                (box :orientation "h" :space-evenly false :halign "center" :spacing 6
                  (label :class "forecast-icon tone-${day.tone}" :text {day.icon})
                  (label :class "forecast-temp" :text "${day.max} / ${day.min}"))
                (label :class "forecast-rain" :text "󰖌 ${day.rain}"))))))
          ; Newest first; scrolling over the list moves through older ones. A click acts like the pill's.
          (revealer :transition "none" :reveal {island_tab == "notif"}
        (box :class "page" :orientation "v" :space-evenly false :spacing 6
          (eventbox :onscroll "${EWW_CONFIG_DIR}/scripts/notif scroll {} &"
            (box :orientation "v" :space-evenly false :spacing 2
              (for row in {notif_center.rows}
                (eventbox :cursor "pointer" :onclick "${EWW_CONFIG_DIR}/scripts/notif click ${row.id} &"
                          :tooltip "${row.summary}${row.body != "" ? " · " + row.body : ""}"
                  (box :class "notif-row ${row.critical ? 'notify-critical' : ''}" :orientation "h"
                       :space-evenly false :spacing 10
                    (box :orientation "h" :space-evenly false :spacing 0 :valign "center"
                      (revealer :transition "none" :reveal {row.image != ""}
                        (box :class "notify-thumb" :valign "center"
                             :style {row.image == "" ? "" : "background-image: url('${row.image}');"}))
                      (revealer :transition "none" :reveal {row.image == ""}
                        (label :class "notify-icon" :width 24 :text {row.icon})))
                    (box :orientation "v" :space-evenly false :spacing 0 :valign "center" :hexpand true
                      (box :orientation "h" :space-evenly false :spacing 8
                        (label :class "notif-summary" :text {row.summary} :xalign 0 :hexpand true
                               :limit-width 46 :show-truncated true :wrap false)
                        (label :class "notif-meta" :text {row.time} :xalign 1))
                      (box :orientation "h" :space-evenly false :spacing 8
                        (label :class "notif-body" :text {row.body} :xalign 0 :hexpand true
                               :limit-width 50 :show-truncated true :wrap false)
                        (label :class "notif-meta" :text {row.app} :xalign 1
                               :limit-width 16 :show-truncated true))))))))
          (box :orientation "h" :space-evenly false
            (label :class "notif-more" :hexpand true :xalign 0
                   :text {notif_center.more > 0 ? "+${notif_center.more} lainnya" : notif_center.total == 0 ? "Tidak ada notifikasi" : ""})
            (button :class "notif-clear" :onclick "${EWW_CONFIG_DIR}/scripts/notif clear &" "Hapus semua")))))
        (box :class "ear ear-right" :valign "start"))))))
