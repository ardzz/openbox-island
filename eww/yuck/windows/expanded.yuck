; The expanded card slides down over the compact island while hovered (scripts/island).
(defwindow island-expanded
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "508px" :height "218px" :anchor "top center")
  :wm-ignore true
  (eventbox :onhover "${EWW_CONFIG_DIR}/scripts/island hover &"
            :onhoverlost "${EWW_CONFIG_DIR}/scripts/island hover &"
    (box :halign "center" :valign "start"
      (revealer :transition "slidedown" :reveal island_reveal :duration "300ms"
        (box :orientation "h" :space-evenly false
          (box :class "ear ear-left" :valign "start")
          (tab-card)
          (box :class "ear ear-right" :valign "start"))))))
