; The notch grows into the expanded card while hovered (scripts/island).
(defwindow island-expanded
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "508px" :height "218px" :anchor "top center")
  :wm-ignore true
  (eventbox :onhover "${EWW_CONFIG_DIR}/scripts/island hover &"
            :onhoverlost "${EWW_CONFIG_DIR}/scripts/island hover &"
    (box :halign "center" :valign "start" :orientation "h" :space-evenly false
      (box :class "ear ear-left" :valign "start")
      (overlay
        ; Like isle's wash: the cover colour rises from clear under the top edge to 75% at the bottom.
        (box :class "notch-shell ${alert.kind != '' ? 'st-alert' : notify.active ? 'st-notify' : media.state == 'none' ? 'st-idle' : 'st-media'} ${island_reveal ? 'grow' : ''}"
             :style {island_reveal && island_tab == "musik" && media.color != "" ? "background-image: linear-gradient(to bottom, alpha(${media.color}, 0), alpha(${media.color}, 0.75));" : ""})
        (stack :halign "center" :valign "start"
               :selected {island_reveal ? 1 : 0} :transition "crossfade" :same-size false
          (stack :halign "center" :valign "start"
                 :selected {alert.kind != "" ? 2 : notify.active ? 3 : media.state == "none" ? 0 : 1}
                 :transition "crossfade" :same-size false
            (pill-idle)
            (pill-media)
            (pill-alert)
            (pill-notify))
          (tab-card)))
      (box :class "ear ear-right" :valign "start"))))
