; The tabs of the expanded card, in the order of scripts/lib/tabs: one header chip and one page each.
; eww's onscroll only reports vertical scrolling: up/down over the header switches tabs.
(defwidget tab-header []
  (eventbox :onscroll "${EWW_CONFIG_DIR}/scripts/tab {} &"
    (box :class "tabs" :orientation "h" :halign "center" :space-evenly false :spacing 4
      (tab-chip :id "musik" :icon "󰎈" :name "Musik" :count 0 :dot false
                :available {media.state != "none"})
      (tab-chip :id "kalender" :icon "󰃭" :name "Kalender" :count {kalender.count} :dot false
                :available {kalender.ok})
      (tab-chip :id "cuaca" :icon "󰖕" :name "Cuaca" :count 0 :dot false :available {weather.ok})
      ; The badge counts the history; the dot marks notifications not seen yet.
      (tab-chip :id "notif" :icon "󰂜" :name "Notifikasi" :count {notif_center.total}
                :dot {notif_center.unread > 0} :available {notif_center.total > 0})
      (tab-chip :id "tugas" :icon "󰗡" :name "Tugas" :count {todo.open} :dot false :available true)
      (tab-chip :id "pintasan" :icon "󱇙" :name "Pintasan" :count 0 :dot false
                :available {shortcuts != "[]"})
      (tab-chip :id "kuota" :icon "󰚩" :name "Kuota" :count 0 :dot false
                :available {kuota.ok}))))

; The expanded card: header, then the pages; only the selected page is revealed.
(defwidget tab-card []
  (box :class "pill pill-expanded" :orientation "v" :space-evenly false
    (tab-header)
    (tab-page :id "musik" (page-musik))
    (tab-page :id "kalender" (page-kalender))
    (tab-page :id "cuaca" (page-cuaca))
    (tab-page :id "notif" (page-notif))
    (tab-page :id "tugas" (page-tugas))
    (tab-page :id "pintasan" (page-pintasan))
    (tab-page :id "kuota" (page-kuota))))
