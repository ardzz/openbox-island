(deflisten media :initial '{"state":"none","player":"","title":"","artist":"","art":"","length":0,"length_text":"0:00"}' "scripts/media")
(defvar island_reveal false)
(defpoll pos :interval "1s" :initial '{"pos":0,"text":"0:00"}' :run-while island_reveal "scripts/position")
; Re-check hover once a second while expanded: a pointer grab by another client can swallow the leave event.
(defpoll island_hover_check :interval "1s" :initial "" :run-while island_reveal "scripts/island hover")
