(deflisten media :initial '{"state":"none","player":"","title":"","artist":"","art":"","length":0,"length_text":"0:00"}' "scripts/media")
(deflisten viz :initial "[0,0,0,0,0,0]" "scripts/viz")
(deflisten lyrics :initial '{"text":"","synced":false}' "scripts/lyrics.py")
(deflisten alert :initial '{"kind":"","icon":"","text":"","value":"","level":-1,"image":""}' "scripts/alert")
(deflisten notify :initial '{"active":false,"id":0,"app":"","summary":"","body":"","icon":"","image":"","critical":false}' "scripts/notify")
(deflisten notif_center :initial '{"total":0,"unread":0,"label":"Notifikasi","rows":[],"more":0,"offset":0}' "scripts/notif")
(deflisten status :initial '{"mic":false,"mic_apps":"","camera":false,"camera_apps":"","dnd":false,"vpn":false,"vpn_desc":""}' "scripts/status")
(deflisten rec :initial '{"active":false,"app":"","time":""}' "scripts/rec")
(deflisten ytm :initial '{"active":false,"video_id":"","like":"","next_title":"","next_artist":""}' "scripts/ytm")
(deflisten weather :initial '{"ok":false,"icon":"","tone":"","temp":"","desc":"","city":"","region":"","feels":"","humidity":"","wind":"","uv":"","sunrise":"","sunset":"","days":[]}' "scripts/weather")
(defvar island_reveal false)
; Shown tab of the expanded card; scripts/island and scripts/tab set it.
(defvar island_tab "musik")
(defpoll pos :interval "1s" :initial '{"pos":0,"text":"0:00"}' :run-while island_reveal "scripts/position")
; Scroll title and artist only while the expanded island is revealed.
(defpoll marquee :interval "200ms" :initial '{"title":"","artist":""}' :run-while island_reveal "scripts/marquee")
; Re-check hover once a second while expanded: a pointer grab by another client can swallow the leave event.
(defpoll island_hover_check :interval "1s" :initial "" :run-while island_reveal "scripts/island hover")
